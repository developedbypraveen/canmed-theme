{%- doc -%}
  Product card — CanMed shop card design (same as Shop page).
  Falls back to Horizon placeholder markup in the theme editor when product is blank.

  @param {object} product - The product object
  @param {object} children - The children of the product card (editor / onboarding only)
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - Unused; kept for Horizon call-site compatibility
  @param {string} [product_view_context] - Unused; kept for Horizon call-site compatibility
{%- enddoc -%}

{% liquid
  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

{% unless onboarding %}
  {% liquid
    assign card_tier = 'otc'
    if product.tags contains 'access-s3' or product.type == 'S3 Pharmacist Only'
      assign card_tier = 's3'
    elsif product.tags contains 'access-otc' or product.type == 'Over the Counter'
      assign card_tier = 'otc'
    elsif product.tags contains 'access-prescription' or product.type == 'Prescription Only'
      assign card_tier = 'prescription'
    endif
  %}
  <div class="cm-product-card-wrap" {{ block.shopify_attributes }}>
    {% render 'canmed-shop-card', product: product, media_tier: card_tier, index: 1 %}
  </div>
{% else %}
  {% assign block_settings = block.settings %}
  <product-card
    class="product-card size-style"
    style="{% render 'size-style', settings: block_settings %}"
    data-placeholder="true"
    {{ block.shopify_attributes }}
  >
    <div
      class="product-card__content layout-panel-flex layout-panel-flex--column product-grid__card spacing-style border-style gap-style"
      style="{% render 'border-override', settings: block_settings %}{% render 'layout-panel-style', settings: block_settings %}{% render 'spacing-style', settings: block_settings %}"
    >
      {{ children }}
    </div>
  </product-card>
  {% render 'product-card-styles' %}
{% endunless %}
