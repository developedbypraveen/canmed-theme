{% comment %} Mobile / form fallback — ports Lovable VesselEcho {% endcomment %}
{% liquid
  assign echo_size = size | default: 220
  assign echo_looping = looping | default: false
%}
<svg
  viewBox="0 0 100 118"
  width="{{ echo_size }}"
  height="{{ echo_size | times: 118.0 | divided_by: 100.0 }}"
  class="cm-vessel-echo"
  aria-hidden="true"
  focusable="false"
  overflow="visible"
>
  <defs>
    <linearGradient id="cm-vessel-fill-{{ section.id }}" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="var(--cm-amber)" stop-opacity="0.85" />
      <stop offset="100%" stop-color="var(--cm-amber-light)" stop-opacity="0.6" />
    </linearGradient>
    <clipPath id="cm-vessel-clip-{{ section.id }}">
      <path d="M42 12h16v14l14 30c4 9-2 20-12 20H40c-10 0-16-11-12-20l14-30z" />
    </clipPath>
  </defs>

  <g clip-path="url(#cm-vessel-clip-{{ section.id }})">
    <rect x="20" y="16" width="60" height="84" fill="url(#cm-vessel-fill-{{ section.id }})" />
  </g>

  <path
    d="M42 12h16v14l14 30c4 9-2 20-12 20H40c-10 0-16-11-12-20l14-30z"
    fill="none"
    stroke="var(--cm-pine)"
    stroke-width="1.4"
    stroke-linejoin="round"
  />
  <path d="M38 9h24" stroke="var(--cm-pine)" stroke-width="2.6" stroke-linecap="round" />

  <circle cx="50" cy="74" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0s;--dur:9s"{% endif %}/>
  <circle cx="58.7" cy="68.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.09s;--dur:9.2s"{% endif %}/>
  <circle cx="63.5" cy="60" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.18s;--dur:9.4s"{% endif %}/>
  <circle cx="61.8" cy="50.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.27s;--dur:9.6s"{% endif %}/>
  <circle cx="54.5" cy="43" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.36s;--dur:9.8s"{% endif %}/>
  <circle cx="44.5" cy="38.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.45s;--dur:10s"{% endif %}/>
  <circle cx="35.2" cy="38" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.54s;--dur:10.2s"{% endif %}/>
  <circle cx="29.5" cy="43.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.63s;--dur:10.4s"{% endif %}/>
  <circle cx="29.2" cy="52.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.72s;--dur:10.6s"{% endif %}/>
  <circle cx="34.5" cy="61" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.81s;--dur:10.8s"{% endif %}/>
  <circle cx="43.8" cy="66.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.9s;--dur:11s"{% endif %}/>
  <circle cx="53.5" cy="67.5" r="1.9" fill="var(--cm-amber)" opacity="0.95" {% if echo_looping %}class="cm-echo-dot" style="--d:0.99s;--dur:11.2s"{% endif %}/>
</svg>
