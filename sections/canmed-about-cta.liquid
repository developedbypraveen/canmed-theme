{% comment %} CanMed — About CTA band {% endcomment %}
{{ 'canmed-about.css' | asset_url | stylesheet_tag }}

<section class="cm-au-cta" data-reveal aria-labelledby="cm-au-cta-title-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="cm-au__shell">
    <div class="cm-au-cta__band">
      <div class="cm-au-cta__row">
        <div>
          {% if section.settings.heading != blank %}
            <h2 class="cm-au-cta__title" id="cm-au-cta-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.body != blank %}
            <p class="cm-au-cta__copy">{{ section.settings.body | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
          <div class="cm-au-cta__actions">
            {% if section.settings.primary_label != blank %}
              <a class="cm-au-btn cm-au-btn--solid" href="{{ section.settings.primary_link | default: '/pages/prescriptions' }}">
                {{ section.settings.primary_label | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </a>
            {% endif %}
            {% if section.settings.secondary_label != blank %}
              <a class="cm-au-btn cm-au-btn--ghost" href="{{ section.settings.secondary_link | default: '/pages/contact' }}">
                {{ section.settings.secondary_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'canmed-about.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CanMed — About CTA",
  "tag": "section",
  "class": "cm-section-about-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready when your script is." },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Send a prescription online, or call the clinic that suits you. We'll take it from the weigh-in."
    },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Start a prescription" },
    { "type": "text", "id": "primary_link", "label": "Primary link", "default": "/pages/prescriptions" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Contact us" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link", "default": "/pages/contact" }
  ],
  "presets": [{ "name": "CanMed — About CTA" }]
}
{% endschema %}
