{% comment %} CanMed — What we make (exact HTML blister pack + theme purple / Poppins) {% endcomment %}
{%- liquid
  assign make_title = section.settings.heading | default: 'Five kinds of problem we solve most often.'
  assign make_line_1 = make_title
  assign make_line_2 = ''
  if make_title contains ' we '
    assign make_parts = make_title | split: ' we '
    assign make_line_1 = make_parts[0] | append: ' we'
    assign make_line_2 = make_parts[1]
  endif
-%}

<style>
/* ===== CanMed | What we make (scoped) — HTML parity, theme color + Poppins ===== */
.cm-make{
  --cm-deep:#7a28a0;
  --cm-plum:#9d3ec6;
  --cm-orchid:#c850d1;
  --cm-soft:#e0b8f0;
  --cm-lilac:#fae8f8;
  --cm-bg:#faf5fd;
  --cm-line:#eadcf3;
  --cm-ink:#4a3f52;
  --cm-muted:#6f6379;
  --cm-display:'Poppins',ui-sans-serif,system-ui,sans-serif;
  --cm-body:'Poppins',ui-sans-serif,system-ui,sans-serif;
  --cm-ease:cubic-bezier(.22,1,.36,1);
  --cm-cycle:3200ms;

  position:relative;overflow:hidden;
  background:var(--cm-bg);color:var(--cm-ink);font-family:var(--cm-body);
  padding:clamp(64px,8vw,120px) clamp(20px,5vw,64px);
}
.cm-make *,.cm-make *::before,.cm-make *::after{box-sizing:border-box}
.cm-make :where(h2,h3,p,ul){margin:0;padding:0}
.cm-make__inner{max-width:1240px;margin:0 auto}

.cm-make__eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--cm-display);font-weight:500;font-size:15px;
  letter-spacing:.14em;text-transform:uppercase;color:var(--cm-orchid);
  margin-bottom:18px;opacity:0;transition:opacity 700ms ease;
}
.cm-make__eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--cm-orchid)}
.cm-make__title{
  font-family:var(--cm-display);font-weight:600;
  font-size:clamp(36px,5vw,72px);line-height:1.04;letter-spacing:-.03em;color:var(--cm-plum) !important;
}
.cm-make__line{display:block;overflow:hidden;padding-bottom:.08em}
.cm-make__line > span{display:block;transform:translateY(105%);transition:transform 900ms var(--cm-ease)}
.cm-make__line:nth-child(2) > span{transition-delay:120ms}
.cm-make.is-in .cm-make__eyebrow{opacity:1}
.cm-make.is-in .cm-make__line > span{transform:none}

.cm-make__pack{
  margin-top:clamp(40px,5vw,64px);
  background:#fff;border:1px solid var(--cm-line);border-radius:30px;
  padding:clamp(26px,3vw,40px) clamp(6px,1vw,14px);
  box-shadow:0 30px 70px -45px rgba(122,40,160,.35);
}
.cm-make__list{list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}

.cm-make__item{
  position:relative;padding:0 clamp(12px,1.6vw,24px);outline:none;cursor:default;
  display:flex;flex-direction:column;align-items:flex-start;
}
.cm-make__item + .cm-make__item::before{
  content:"";position:absolute;left:0;top:6px;bottom:6px;width:0;
  border-left:2px dashed var(--cm-line);
}

.cm-make__pocket{
  position:relative;display:grid;place-items:center;
  width:100%;max-width:150px;aspect-ratio:5 / 6;border-radius:999px;
  background:radial-gradient(circle at 34% 24%,#fff 0,var(--cm-lilac) 62%);
  box-shadow:inset 0 -8px 16px rgba(157,62,198,.10),inset 0 2px 0 #fff,0 1px 0 var(--cm-line);
  color:var(--cm-plum);
  opacity:0;transform:scale(.82);
  transition:opacity 600ms ease,transform 700ms cubic-bezier(.34,1.56,.64,1),box-shadow 500ms ease,color 500ms ease;
  transition-delay:calc(var(--i) * 110ms + 300ms),calc(var(--i) * 110ms + 300ms),0s,0s;
}
.cm-make__pocket::before{
  content:"";position:absolute;inset:0;border-radius:inherit;
  background:radial-gradient(circle at 34% 24%,var(--cm-orchid) 0,var(--cm-plum) 45%,var(--cm-deep) 100%);
  opacity:0;transition:opacity 500ms ease;
}
.cm-make__pocket::after{
  content:"";position:absolute;top:11%;left:22%;width:24%;height:13%;border-radius:50%;
  background:rgba(255,255,255,.55);transform:rotate(-24deg);filter:blur(.5px);
}
.cm-make.is-in .cm-make__pocket{opacity:1;transform:none}

.cm-make__icon{
  position:relative;z-index:1;width:60%;height:auto;
  fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  overflow:visible;
}
.cm-make__icon .a{transform-box:fill-box}

.cm-make__item--open .cm-make__pocket{
  background:transparent;box-shadow:none;border:2px dashed var(--cm-soft);
}
.cm-make__item--open .cm-make__pocket::after{display:none}

.cm-make__name{
  position:relative;margin-top:26px !important;padding-bottom:8px;
  font-family:var(--cm-display);font-weight:600;font-size:clamp(16px,1.4vw,20px);line-height:1.2;
  color:var(--cm-plum) !important;letter-spacing:-.01em;hyphens:manual;
}
.cm-make__name::after{
  content:"";position:absolute;left:0;bottom:0;height:2px;width:100%;
  background:var(--cm-plum);transform:scaleX(0);transform-origin:left;
}
.cm-make__text{margin-top:8px !important;font-size:clamp(14.5px,1.15vw,16px);line-height:1.6;color:var(--cm-muted)}

.cm-make__item.is-active .cm-make__pocket{
  color:#fff;box-shadow:0 22px 34px -16px rgba(122,40,160,.6);
  transform:translateY(-8px);transition-delay:0s;
}
.cm-make__item.is-active .cm-make__pocket::before{opacity:1}
.cm-make__item--open.is-active .cm-make__pocket{border-color:transparent}
.cm-make__item.is-active .cm-make__name::after{animation:cmMakeTimer var(--cm-cycle) linear both}
.cm-make.is-held .cm-make__item.is-active .cm-make__name::after{animation:none;transform:scaleX(1)}
.cm-make__item:focus-visible .cm-make__pocket{outline:2px solid var(--cm-plum);outline-offset:5px}
@keyframes cmMakeTimer{from{transform:scaleX(0)}to{transform:scaleX(1)}}

.is-active .liquid{transform-origin:50% 100%;animation:cmMakeFill var(--cm-cycle) var(--cm-ease) both}
.is-active .bubble{animation:cmMakeBubble 1.4s ease-in infinite;animation-delay:var(--d)}
@keyframes cmMakeFill{0%{transform:scaleY(.15)}45%,100%{transform:scaleY(1)}}
@keyframes cmMakeBubble{0%{transform:translateY(0);opacity:0}20%{opacity:1}100%{transform:translateY(-12px);opacity:0}}

.cm-make .drop{opacity:0}
.is-active .half-a{animation:cmMakeHalfA var(--cm-cycle) var(--cm-ease) both}
.is-active .half-b{animation:cmMakeHalfB var(--cm-cycle) var(--cm-ease) both}
.is-active .drop{transform-origin:50% 60%;animation:cmMakeDrop var(--cm-cycle) cubic-bezier(.34,1.56,.64,1) both}
@keyframes cmMakeHalfA{0%,18%{transform:translateX(0);opacity:1}38%{transform:translateX(-7px);opacity:1}50%,100%{transform:translateX(-7px);opacity:0}}
@keyframes cmMakeHalfB{0%,18%{transform:translateX(0);opacity:1}38%{transform:translateX(7px);opacity:1}50%,100%{transform:translateX(7px);opacity:0}}
@keyframes cmMakeDrop{0%,48%{transform:scale(.3);opacity:0}62%,100%{transform:scale(1);opacity:1}}

.is-active .toe{transform-origin:50% 50%;animation:cmMakePop 700ms cubic-bezier(.34,1.56,.64,1) both;animation-delay:var(--d)}
.is-active .pad{transform-origin:50% 50%;animation:cmMakePop 700ms cubic-bezier(.34,1.56,.64,1) both;animation-delay:.75s}
@keyframes cmMakePop{0%{transform:scale(0)}100%{transform:scale(1)}}

.cm-make .stem{stroke-dasharray:1;stroke-dashoffset:0}
.is-active .stem{animation:cmMakeStem 900ms ease both}
.is-active .leaf-l{transform-origin:100% 100%;animation:cmMakeLeaf 800ms cubic-bezier(.34,1.56,.64,1) both;animation-delay:.7s}
.is-active .leaf-r{transform-origin:0% 100%;animation:cmMakeLeaf 800ms cubic-bezier(.34,1.56,.64,1) both;animation-delay:.95s}
@keyframes cmMakeStem{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
@keyframes cmMakeLeaf{from{transform:scale(0)}to{transform:scale(1)}}

.cm-make .route{stroke-dasharray:1;stroke-dashoffset:0}
.is-active .route{animation:cmMakeStem 700ms ease both;animation-delay:var(--d)}
.is-active .end{transform-origin:50% 50%;animation:cmMakePop 600ms cubic-bezier(.34,1.56,.64,1) both;animation-delay:var(--d)}

@media (max-width:1024px){
  .cm-make__item{padding:0 12px}
  .cm-make__name{margin-top:20px !important}
}
@media (max-width:720px){
  .cm-make__pack{padding:26px 0;border-radius:24px}
  .cm-make__list{
    grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:minmax(160px,42%);
    overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    padding:18px 6px 4px;scrollbar-width:none;
  }
  .cm-make__list::-webkit-scrollbar{display:none}
  .cm-make__item{scroll-snap-align:start;padding:0 16px}
  .cm-make__pocket{max-width:120px}
}
@media (prefers-reduced-motion:reduce){
  .cm-make *,.cm-make *::before,.cm-make *::after{animation:none !important;transition:none !important}
  .cm-make__eyebrow,.cm-make__pocket{opacity:1;transform:none}
  .cm-make__line > span{transform:none}
  .cm-make .drop{opacity:0}
}
</style>

<section
  class="cm-make"
  id="cm-make-{{ section.id }}"
  data-cm-make
  aria-labelledby="cm-make-title-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="cm-make__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="cm-make__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if make_title != blank %}
      <h2 class="cm-make__title" id="cm-make-title-{{ section.id }}">
        {% if make_line_2 != blank %}
          <span class="cm-make__line"><span>{{ make_line_1 | escape }}</span></span>
          <span class="cm-make__line"><span>{{ make_line_2 | escape }}</span></span>
        {% else %}
          <span class="cm-make__line"><span>{{ make_title | escape }}</span></span>
        {% endif %}
      </h2>
    {% endif %}

    <div class="cm-make__pack">
      <ul class="cm-make__list">
        {% for block in section.blocks %}
          {% if block.type == 'type' %}
            {% liquid
              assign icon = block.settings.icon | default: 'paediatric'
              assign is_open = false
              if icon == 'other'
                assign is_open = true
              endif
            %}
            <li
              class="cm-make__item{% if is_open %} cm-make__item--open{% endif %}"
              tabindex="0"
              style="--i:{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="cm-make__pocket">
                <svg class="cm-make__icon" viewBox="0 0 64 64" aria-hidden="true">
                  {% case icon %}
                    {% when 'geriatric' %}
                      <g transform="rotate(-35 32 32)">
                        <path class="a half-a" d="M30 22h-6a10 10 0 0 0 0 20h6z" fill="currentColor" fill-opacity=".35"></path>
                        <path class="a half-b" d="M34 22h6a10 10 0 0 1 0 20h-6z"></path>
                      </g>
                      <path class="a drop" d="M32 14c7 9 12 15 12 21a12 12 0 0 1-24 0c0-6 5-12 12-21z" fill="currentColor" fill-opacity=".35"></path>
                    {% when 'veterinary' %}
                      <ellipse class="a toe" style="--d:0s" cx="17" cy="30" rx="4.5" ry="5.5"></ellipse>
                      <ellipse class="a toe" style="--d:.15s" cx="26" cy="18" rx="4.5" ry="5.5"></ellipse>
                      <ellipse class="a toe" style="--d:.3s" cx="38" cy="18" rx="4.5" ry="5.5"></ellipse>
                      <ellipse class="a toe" style="--d:.45s" cx="47" cy="30" rx="4.5" ry="5.5"></ellipse>
                      <path class="a pad" d="M32 34c-8 0-14 7-14 13 0 4 3 7 7 7 2.5 0 4.5-1.2 7-1.2s4.5 1.2 7 1.2c4 0 7-3 7-7 0-6-6-13-14-13z" fill="currentColor" fill-opacity=".35"></path>
                    {% when 'phyto' %}
                      <path d="M20 56h24"></path>
                      <path class="a stem" pathLength="1" d="M32 56V28"></path>
                      <path class="a leaf-l" d="M32 40c-11 0-16-6-16-14 9 0 16 5 16 14z" fill="currentColor" fill-opacity=".35"></path>
                      <path class="a leaf-r" d="M32 32c0-10 6-16 16-16 0 9-6 16-16 16z" fill="currentColor" fill-opacity=".35"></path>
                    {% when 'other' %}
                      <circle cx="10" cy="32" r="4" fill="currentColor" stroke="none"></circle>
                      <path d="M14 32h12"></path>
                      <path class="a route" style="--d:0s" pathLength="1" d="M26 32c8 0 8-14 16-14h8"></path>
                      <path class="a route" style="--d:.3s" pathLength="1" d="M26 32h24"></path>
                      <path class="a route" style="--d:.6s" pathLength="1" d="M26 32c8 0 8 14 16 14h8"></path>
                      <circle class="a end" style="--d:.55s" cx="54" cy="18" r="4"></circle>
                      <circle class="a end" style="--d:.85s" cx="54" cy="32" r="4"></circle>
                      <circle class="a end" style="--d:1.15s" cx="54" cy="46" r="4"></circle>
                    {% else %}
                      <rect x="25" y="6" width="14" height="6" rx="1.5"></rect>
                      <path d="M27 12v6l-7 8v26a4 4 0 0 0 4 4h16a4 4 0 0 0 4-4V26l-7-8v-6"></path>
                      <path class="a liquid" d="M21.5 36h21v16a2.5 2.5 0 0 1-2.5 2.5H24a2.5 2.5 0 0 1-2.5-2.5z" fill="currentColor" fill-opacity=".35" stroke="none"></path>
                      <circle class="a bubble" style="--d:0s" cx="28" cy="47" r="1.6" fill="currentColor" stroke="none"></circle>
                      <circle class="a bubble" style="--d:.45s" cx="34" cy="50" r="1.3" fill="currentColor" stroke="none"></circle>
                      <circle class="a bubble" style="--d:.9s" cx="38" cy="45" r="1.5" fill="currentColor" stroke="none"></circle>
                  {% endcase %}
                </svg>
              </span>
              {% if block.settings.title != blank %}
                <h3 class="cm-make__name">
                  {%- if icon == 'phyto' and block.settings.title == 'Phytocannabinoid' -%}
                    Phyto&shy;cannabinoid
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class="cm-make__text">{{ block.settings.body | escape }}</p>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('cm-make-{{ section.id }}');
  if (!root || root.dataset.cmMakeReady === '1') return;
  root.dataset.cmMakeReady = '1';

  var items = [].slice.call(root.querySelectorAll('.cm-make__item'));
  var list = root.querySelector('.cm-make__list');
  if (!list || items.length < 1) return;

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var CYCLE = 3200;
  var current = -1, timer = null, inView = false, held = false, started = false;

  function setActive(i) {
    current = i;
    items.forEach(function (el, k) {
      el.classList.remove('is-active');
      if (k === i) {
        void el.offsetWidth;
        el.classList.add('is-active');
      }
    });
  }

  function schedule() {
    clearTimeout(timer);
    if (!inView || held || reduce) return;
    timer = setTimeout(function () {
      setActive((current + 1) % items.length);
      if (list.scrollWidth > list.clientWidth + 4) {
        list.scrollTo({ left: items[current].offsetLeft - 6, behavior: 'smooth' });
      }
      schedule();
    }, CYCLE);
  }

  items.forEach(function (el, k) {
    function pick() {
      held = true;
      root.classList.add('is-held');
      clearTimeout(timer);
      if (k !== current) setActive(k);
    }
    el.addEventListener('mouseenter', pick);
    el.addEventListener('focus', pick);
    el.addEventListener('click', pick);
  });

  function release() {
    held = false;
    root.classList.remove('is-held');
    setActive(current);
    schedule();
  }
  list.addEventListener('mouseleave', release);
  list.addEventListener('focusout', function (e) {
    if (!list.contains(e.relatedTarget)) release();
  });

  function begin() {
    if (started) return;
    started = true;
    inView = true;
    root.classList.add('is-in');
    if (reduce) return;
    setTimeout(function () {
      setActive(0);
      schedule();
    }, 1200);
  }

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      inView = entries[0].isIntersecting;
      if (inView && !started) begin();
      else if (inView) schedule();
      else clearTimeout(timer);
    }, { threshold: 0.25 }).observe(root);
  } else {
    begin();
  }

  setTimeout(function () {
    if (!started) begin();
  }, 800);
})();
</script>

{% schema %}
{
  "name": "CanMed — What we make",
  "tag": "div",
  "class": "cm-section-rx-types",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What we make"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Five kinds of problem we solve most often.",
      "info": "If the heading includes “ we ”, it splits onto two lines for the entrance animation."
    }
  ],
  "blocks": [
    {
      "type": "type",
      "name": "Type",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "paediatric",
          "options": [
            { "value": "paediatric", "label": "Paediatric" },
            { "value": "geriatric", "label": "Geriatric" },
            { "value": "veterinary", "label": "Veterinary" },
            { "value": "phyto", "label": "Phytocannabinoid" },
            { "value": "other", "label": "Something else" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Paediatric"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Child-scaled doses and flavours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CanMed — What we make",
      "blocks": [
        {
          "type": "type",
          "settings": {
            "icon": "paediatric",
            "title": "Paediatric",
            "body": "Child-scaled doses and flavours"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "geriatric",
            "title": "Geriatric",
            "body": "Swallowing and polypharmacy support"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "veterinary",
            "title": "Veterinary",
            "body": "Species-specific formulations"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "phyto",
            "title": "Phytocannabinoid",
            "body": "Approved prescriptions only"
          }
        },
        {
          "type": "type",
          "settings": {
            "icon": "other",
            "title": "Something else",
            "body": "Tell us and we'll route it"
          }
        }
      ]
    }
  ]
}
{% endschema %}
