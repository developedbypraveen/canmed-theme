

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section section--full-width cm-cart-section{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
    >
      <div class="cm-shell">
        <div
          class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
          style="{% render 'spacing-style', settings: section.settings %}"
        >
          <div class="cart-page__title">
            {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
          </div>
          <div class="cart-page__items">
            {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
          </div>
          {{ cart_page_more_blocks_content }}
        </div>
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section section--full-width cm-cart-section{% if custom_color %} color-custom-{{ section.id }}{% endif %}"
  >
    <div class="cm-shell">
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
        </div>
        {% unless cart.empty? %}
        <p class="cm-mono-data" style="margin:0.75rem 0 0;">This cart is for over-the-counter products. Compounded and prescription medicines are ordered through our prescription form, and a pharmacist will contact you with a price.</p>
        <p class="cm-mono-data" style="margin:0.5rem 0 0;">Always read the label and follow the directions for use.</p>
        <p class="cm-mono-data" style="margin:0.5rem 0 1rem;">Collect from West Lakes or King William Street, or choose delivery at the next step.</p>
        <p class="cm-mono-data" style="margin:0 0 1rem;">Prices include GST where it applies. Questions before you buy? Email <a href="mailto:orders.adelaide@canmedcompounding.com">orders.adelaide@canmedcompounding.com</a> and ask for a pharmacist.</p>
        {% else %}
        <p class="cm-body-l" style="margin-top:1rem;">Browse our over-the-counter range, or send a prescription if you need a medicine compounded.</p>
        <p style="margin-top:1rem;"><a class="cm-btn cm-btn--accent" href="/pages/shop">Shop products</a> <a class="cm-btn cm-btn--secondary" href="/pages/prescriptions">Send a prescription</a></p>
        {% endunless %}

        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
        </div>

        {%- unless cart.empty? -%}
          <div class="cart-page__summary">
            {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
          </div>
        {%- endunless -%}

        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </div>
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: minmax(0, 1fr) 300px;
      grid-template-rows: auto auto;
      align-items: start;
    }

    .cart-page__title {
      grid-column: 1 / -1;
    }

    .cart-page__summary {
      display: block;
      height: auto;
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      padding-top: 0;
      position: sticky;
      top: calc(var(--header-group-height, 5rem) + 1rem);
    }

    /* Never bleed cart out of the page-width center column */
    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
