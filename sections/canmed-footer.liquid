{% comment %} CanMed footer — matches Lovable SiteChrome Footer {% endcomment %}
<footer class="cm-footer" {{ section.shopify_attributes }}>
  <div class="cm-shell cm-footer__inner">
    <div class="cm-footer__grid">
      <div class="cm-footer__brand">
        <div class="cm-footer__brand-lockup">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 234
              | image_tag:
                class: 'cm-footer__logo',
                widths: '65, 78, 130, 156, 234',
                sizes: '(max-width: 767px) 78px, 65px',
                loading: 'lazy',
                alt: shop.name
            }}
          {% else %}
            <img
              class="cm-footer__logo"
              src="{{ 'canmed-logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="78"
              height="78"
              loading="lazy"
            >
          {% endif %}
          <div class="cm-footer__wordmark">
            <p class="cm-footer__name">{{ section.settings.brand_name | default: 'CanMed' | escape }}</p>
            {% if section.settings.brand_tagline != blank %}
              <p class="cm-footer__tagline">{{ section.settings.brand_tagline | escape }}</p>
            {% endif %}
          </div>
        </div>
        {% if section.settings.tagline != blank %}
          <p class="cm-footer__blurb">{{ section.settings.tagline | escape }}</p>
        {% endif %}
      </div>

      <div class="cm-footer__locations">
        {% for block in section.blocks %}
          {% if block.type == 'location' %}
            <div class="cm-footer__location" {{ block.shopify_attributes }}>
              {% if block.settings.name != blank %}
                <p class="cm-footer__loc-name">{{ block.settings.name | escape }}</p>
              {% endif %}
              <address class="cm-footer__address">
                {% if block.settings.address != blank %}
                  {{ block.settings.address | escape }}<br>
                {% endif %}
                {% if block.settings.suburb != blank %}
                  {{ block.settings.suburb | escape }}<br>
                {% endif %}
                {% if block.settings.phone != blank %}
                  {% if block.settings.phone_link != blank %}
                    <a href="{{ block.settings.phone_link }}">{{ block.settings.phone | escape }}</a>
                  {% else %}
                    <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">
                      {{- block.settings.phone | escape -}}
                    </a>
                  {% endif %}
                {% endif %}
              </address>
              <dl class="cm-footer__hours">
                {% if block.settings.hours_1_days != blank %}
                  <div><dt>{{ block.settings.hours_1_days | escape }}</dt><dd>{{ block.settings.hours_1_time | escape }}</dd></div>
                {% endif %}
                {% if block.settings.hours_2_days != blank %}
                  <div><dt>{{ block.settings.hours_2_days | escape }}</dt><dd>{{ block.settings.hours_2_time | escape }}</dd></div>
                {% endif %}
                {% if block.settings.hours_3_days != blank %}
                  <div><dt>{{ block.settings.hours_3_days | escape }}</dt><dd>{{ block.settings.hours_3_time | escape }}</dd></div>
                {% endif %}
              </dl>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="cm-footer__news">
      <h2 class="cm-footer__news-title">News from the pharmacy</h2>
      <p class="cm-footer__news-intro">Opening hours, new over-the-counter products, and practical tips on storing and taking medicines. About once a month.</p>
      {% form 'customer', id: 'cm-newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="cm-footer__news-fields">
          <label>
            <span>First name</span>
            <input id="cm-news-name" type="text" name="contact[first_name]" autocomplete="given-name">
          </label>
          <label>
            <span>Email</span>
            <input id="cm-news-email" type="email" name="contact[email]" required autocomplete="email">
          </label>
        </div>
        <label class="cm-footer__news-consent">
          <input type="checkbox" name="contact[note]" value="newsletter-consent" required>
          <span>Yes, send me emails from CanMed Compounding Chemist. I can unsubscribe at any time.</span>
        </label>
        <button type="submit" class="cm-btn cm-btn--accent">Sign up</button>
        <p class="cm-footer__news-note">We'll only use your email for this newsletter. See our <a href="{{ section.settings.link_privacy | default: '/policies/privacy-policy' }}">Privacy Policy</a>.</p>
        {% if form.posted_successfully? %}
          <p class="cm-footer__news-note">Thanks, you're on the list. Your first email will arrive soon.</p>
        {% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>

    {% if section.settings.show_compliance %}
      <div class="cm-footer__compliance">
        <p class="cm-footer__compliance-eyebrow">{{ section.settings.compliance_eyebrow | escape }}</p>
        <p class="cm-footer__compliance-body">{{ section.settings.compliance_body | escape }}</p>
        {% if section.settings.compliance_extra != blank %}
          <p class="cm-footer__compliance-body">{{ section.settings.compliance_extra | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="cm-footer__legal">
      <p class="cm-footer__copy">
        © {{ 'now' | date: '%Y' }}
        {{ section.settings.copyright | default: 'CanMed Compounding Chemist.' | escape }}
      </p>
      <div class="cm-footer__legal-links">
        <a href="{{ section.settings.link_privacy | default: '/policies/privacy-policy' }}">Privacy Policy</a>
        <a href="{{ section.settings.link_terms | default: '/policies/terms-of-service' }}">Terms & Conditions</a>
        <a href="{{ section.settings.link_contact | default: '/pages/contact' }}">Contact</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "CanMed — Footer",
  "tag": "section",
  "class": "cm-section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "CanMed"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "Compounding Chemist"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Blurb",
      "default": "Medicines compounded to the person taking them, from our West Lakes and Adelaide clinics."
    },
    {
      "type": "checkbox",
      "id": "show_compliance",
      "label": "Show regulatory notice",
      "default": true
    },
    {
      "type": "text",
      "id": "compliance_eyebrow",
      "label": "Notice heading",
      "default": "Regulatory notice"
    },
    {
      "type": "textarea",
      "id": "compliance_body",
      "label": "Notice body",
      "default": "Compounded medicines are prepared by a pharmacist for one patient, on a valid prescription. They are not assessed by the Therapeutic Goods Administration (TGA) for safety, quality or effectiveness the way registered medicines are. If a suitable registered medicine is available, your prescriber or pharmacist may recommend it instead. Prescription-only and controlled medicines are supplied only on a valid Australian prescription. Information on this site is general in nature and is not medical advice."
    },
    {
      "type": "textarea",
      "id": "compliance_extra",
      "label": "Notice second line",
      "default": "For over-the-counter products, always read the label and follow the directions for use."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "CanMed Compounding Chemist."
    },
    {
      "type": "url",
      "id": "link_privacy",
      "label": "Privacy link"
    },
    {
      "type": "url",
      "id": "link_terms",
      "label": "Terms link"
    },
    {
      "type": "url",
      "id": "link_admin",
      "label": "Staff portal link"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "CanMED West Lakes Clinic" },
        { "type": "text", "id": "address", "label": "Street address", "default": "Unit 5, 151 Brebner Drive" },
        { "type": "text", "id": "suburb", "label": "Suburb", "default": "West Lakes SA 5021" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "(08) 8450 3978" },
        { "type": "text", "id": "phone_link", "label": "Phone link", "default": "tel:+61884503978" },
        { "type": "text", "id": "hours_1_days", "label": "Hours 1 — days", "default": "Mon – Fri" },
        { "type": "text", "id": "hours_1_time", "label": "Hours 1 — time", "default": "9:00 AM – 6:00 PM" },
        { "type": "text", "id": "hours_2_days", "label": "Hours 2 — days", "default": "Saturday" },
        { "type": "text", "id": "hours_2_time", "label": "Hours 2 — time", "default": "9:30 AM – 5:00 PM" },
        { "type": "text", "id": "hours_3_days", "label": "Hours 3 — days", "default": "Sunday & public holidays" },
        { "type": "text", "id": "hours_3_time", "label": "Hours 3 — time", "default": "Closed" }
      ]
    }
  ]
}
{% endschema %}
