{% comment %} CanMed — Three ways in (exact HTML reference + theme purple / Poppins) {% endcomment %}

<style>
/* ===== CanMed | Three ways in (scoped) — HTML parity, theme color + Poppins ===== */
.cm-ways{
  --cm-deep:#7a28a0;
  --cm-plum:#9d3ec6;
  --cm-orchid:#c850d1;
  --cm-link:#9d3ec6;
  --cm-soft:#e0b8f0;
  --cm-lilac:#fae8f8;
  --cm-bg:#faf5fd;
  --cm-line:#eadcf3;
  --cm-ink:#4a3f52;
  --cm-muted:#6f6379;
  --cm-display:'Poppins',ui-sans-serif,system-ui,sans-serif;
  --cm-body:'Poppins',ui-sans-serif,system-ui,sans-serif;
  --cm-ease:cubic-bezier(.22,1,.36,1);

  position:relative;overflow:hidden;
  background:var(--cm-bg);color:var(--cm-ink);font-family:var(--cm-body);
  padding:clamp(64px,8vw,128px) clamp(20px,5vw,64px);
}
.cm-ways *,.cm-ways *::before,.cm-ways *::after{box-sizing:border-box}
.cm-ways h2,.cm-ways h3,.cm-ways p{margin:0;padding:0}
.cm-ways__inner{position:relative;z-index:1;max-width:1240px;margin:0 auto}

.cm-ways__dots{position:absolute;inset:0;z-index:0;pointer-events:none}
.cm-ways__dots span{
  position:absolute;width:var(--s,8px);height:var(--s,8px);border-radius:50%;
  background:var(--cm-soft);opacity:.45;
  animation:cmWaysFloat var(--t,16s) ease-in-out infinite alternate;animation-delay:var(--d,0s);
}
@keyframes cmWaysFloat{
  0%{transform:translate(0,0)}
  50%{transform:translate(18px,-26px)}
  100%{transform:translate(-14px,12px)}
}

.cm-ways__eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--cm-display);font-weight:500;font-size:15px;
  letter-spacing:.14em;text-transform:uppercase;color:var(--cm-orchid);
  margin-bottom:18px;
  opacity:0;transition:opacity 700ms ease;
}
.cm-ways__eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--cm-orchid)}
.cm-ways__title{
  font-family:var(--cm-display);font-weight:600;
  font-size:clamp(44px,6vw,84px);line-height:1;letter-spacing:-.035em;color:var(--cm-plum) !important;
  overflow:hidden;padding-bottom:.1em;
}
.cm-ways__title span{display:block;transform:translateY(105%);transition:transform 900ms var(--cm-ease) 100ms}
.cm-ways.is-in .cm-ways__eyebrow{opacity:1}
.cm-ways.is-in .cm-ways__title span{transform:none}

.cm-ways__grid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:clamp(18px,2vw,28px);margin-top:clamp(40px,5vw,64px);
}
.cm-ways__card{
  --mx:50%;--my:0%;
  position:relative;display:flex;flex-direction:column;
  background:#fff;border:1px solid var(--cm-line);border-radius:22px;
  text-decoration:none;color:inherit;overflow:hidden;isolation:isolate;
  box-shadow:0 1px 0 rgba(122,40,160,.04);
  opacity:0;transform:translateY(48px);
  transition:opacity 800ms ease,transform 900ms var(--cm-ease),box-shadow 450ms ease,border-color 450ms ease;
}
.cm-ways.is-in .cm-ways__card{opacity:1;transform:none}
.cm-ways.is-in .cm-ways__card:nth-child(2){transition-delay:120ms,120ms,0s,0s}
.cm-ways.is-in .cm-ways__card:nth-child(3){transition-delay:240ms,240ms,0s,0s}

.cm-ways__card::before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:radial-gradient(420px circle at var(--mx) var(--my),rgba(200,80,209,.13),transparent 62%);
  opacity:0;transition:opacity 400ms ease;
}
.cm-ways__bar{
  position:absolute;top:0;left:0;right:0;height:4px;z-index:2;
  background:linear-gradient(90deg,var(--cm-deep),var(--cm-plum) 55%,var(--cm-orchid));
  transform:scaleX(.28);transform-origin:left;transition:transform 700ms var(--cm-ease);
}

.cm-ways__art{
  position:relative;height:clamp(150px,13vw,180px);margin:10px 10px 0;border-radius:16px;
  background:var(--cm-lilac);display:grid;place-items:center;overflow:hidden;
  transition:background 450ms ease;
}
.cm-ways__art svg{width:100%;height:100%;max-width:260px;overflow:visible}

.cm-ways__body{display:flex;flex-direction:column;flex:1;padding:26px 28px 30px}
.cm-ways__tag{
  font-family:var(--cm-display);font-weight:500;font-size:14px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--cm-muted);
}
.cm-ways__name{
  margin-top:12px !important;
  font-family:var(--cm-display);font-weight:600;
  font-size:clamp(26px,2.4vw,36px);line-height:1.08;letter-spacing:-.02em;color:var(--cm-plum) !important;
}
.cm-ways__text{margin-top:14px !important;font-size:16.5px;line-height:1.62;color:var(--cm-muted);max-width:36ch}
.cm-ways__open{
  margin-top:auto;padding-top:26px;display:inline-flex;align-items:center;gap:8px;
  font-weight:500;font-size:17px;color:var(--cm-link);
}
.cm-ways__open svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform 450ms var(--cm-ease)}

.cm-ways__card:hover,.cm-ways__card:focus-visible{
  transform:translateY(-8px);border-color:var(--cm-soft);
  box-shadow:0 30px 60px -28px rgba(122,40,160,.35),0 8px 18px -10px rgba(122,40,160,.15);
}
.cm-ways__card:hover::before,.cm-ways__card:focus-visible::before{opacity:1}
.cm-ways__card:hover .cm-ways__bar,.cm-ways__card:focus-visible .cm-ways__bar{transform:scaleX(1)}
.cm-ways__card:hover .cm-ways__art,.cm-ways__card:focus-visible .cm-ways__art{background:#f0d4f8}
.cm-ways__card:hover .cm-ways__open svg,.cm-ways__card:focus-visible .cm-ways__open svg{transform:translateX(6px)}
.cm-ways__card:focus-visible{outline:none;box-shadow:0 0 0 3px var(--cm-bg),0 0 0 5px var(--cm-plum)}

.cm-ways svg .a{transform-box:fill-box}
.cm-ways .stroke{fill:none;stroke-linecap:round;stroke-linejoin:round}

.cm-ways .shelf-item{transform-origin:50% 100%;animation:cmWaysDrop 6.5s var(--cm-ease) infinite both;animation-delay:var(--d)}
@keyframes cmWaysDrop{
  0%{transform:translateY(-26px);opacity:0}
  9%{transform:translateY(2px);opacity:1}
  12%{transform:translateY(0)}
  80%{transform:translateY(0);opacity:1}
  90%,100%{transform:translateY(0);opacity:0}
}

.cm-ways .ring-seg{stroke-dasharray:1;stroke-dashoffset:0}
.cm-ways .ring-seg.s1{animation:cmWaysArc1 7s ease-in-out infinite}
.cm-ways .ring-seg.s2{animation:cmWaysArc2 7s ease-in-out infinite}
.cm-ways .ring-seg.s3{animation:cmWaysArc3 7s ease-in-out infinite}
.cm-ways .ring-seg.s4{animation:cmWaysArc4 7s ease-in-out infinite}
@keyframes cmWaysArc1{0%{stroke-dashoffset:1;opacity:1}10%{stroke-dashoffset:0}80%{stroke-dashoffset:0;opacity:1}90%,100%{stroke-dashoffset:0;opacity:0}}
@keyframes cmWaysArc2{0%,10%{stroke-dashoffset:1;opacity:1}20%{stroke-dashoffset:0}80%{stroke-dashoffset:0;opacity:1}90%,100%{stroke-dashoffset:0;opacity:0}}
@keyframes cmWaysArc3{0%,20%{stroke-dashoffset:1;opacity:1}30%{stroke-dashoffset:0}80%{stroke-dashoffset:0;opacity:1}90%,100%{stroke-dashoffset:0;opacity:0}}
@keyframes cmWaysArc4{0%,30%{stroke-dashoffset:1;opacity:1}40%{stroke-dashoffset:0}80%{stroke-dashoffset:0;opacity:1}90%,100%{stroke-dashoffset:0;opacity:0}}
.cm-ways .ring-check{transform-origin:50% 50%;animation:cmWaysCheck 7s cubic-bezier(.34,1.56,.64,1) infinite}
@keyframes cmWaysCheck{0%,42%{transform:scale(0)}48%{transform:scale(1.15)}52%,80%{transform:scale(1)}88%,100%{transform:scale(0)}}
.cm-ways .doc-line{transform-origin:0 50%;animation:cmWaysDocLine 7s ease infinite;animation-delay:var(--d)}
@keyframes cmWaysDocLine{0%{transform:scaleX(.2);opacity:.4}12%,80%{transform:scaleX(1);opacity:1}92%,100%{transform:scaleX(.2);opacity:.4}}

.cm-ways .chat-q{transform-origin:0% 100%;animation:cmWaysQ 6.5s var(--cm-ease) infinite}
.cm-ways .chat-a{transform-origin:100% 100%;animation:cmWaysA 6.5s var(--cm-ease) infinite}
.cm-ways .chat-dots{animation:cmWaysDots 6.5s linear infinite}
.cm-ways .chat-dots circle{animation:cmWaysBlink 900ms ease-in-out infinite;animation-delay:var(--d)}
.cm-ways .chat-line{transform-origin:0 50%;animation:cmWaysLine 6.5s var(--cm-ease) infinite;animation-delay:var(--d)}
@keyframes cmWaysQ{0%{transform:scale(.6);opacity:0}8%,84%{transform:scale(1);opacity:1}94%,100%{transform:scale(1);opacity:0}}
@keyframes cmWaysA{0%,12%{transform:scale(.6);opacity:0}18%,84%{transform:scale(1);opacity:1}94%,100%{transform:scale(1);opacity:0}}
@keyframes cmWaysDots{0%,18%{opacity:0}20%,34%{opacity:1}36%,100%{opacity:0}}
@keyframes cmWaysBlink{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes cmWaysLine{0%,36%{transform:scaleX(0)}48%,84%{transform:scaleX(1);opacity:1}94%,100%{transform:scaleX(1);opacity:0}}

.cm-ways:not(.is-in) .a,.cm-ways:not(.is-in) .a *,
.cm-ways.is-paused .a,.cm-ways.is-paused .a *{animation-play-state:paused !important}

@media (max-width:1024px){
  .cm-ways__grid{gap:16px}
  .cm-ways__art{height:140px;margin:8px 8px 0;border-radius:14px}
  .cm-ways__body{padding:20px 20px 24px}
  .cm-ways__tag{font-size:12px}
  .cm-ways__name{font-size:clamp(20px,2.6vw,26px)}
  .cm-ways__text{font-size:15px;line-height:1.55}
  .cm-ways__open{font-size:16px;padding-top:20px}
}
@media (max-width:680px){
  .cm-ways__grid{grid-template-columns:1fr}
  .cm-ways__art{height:160px}
  .cm-ways__body{padding:22px 22px 26px}
  .cm-ways__name{font-size:26px}
}
@media (prefers-reduced-motion:reduce){
  .cm-ways *,.cm-ways *::before,.cm-ways *::after{animation:none !important;transition:none !important}
  .cm-ways__eyebrow,.cm-ways__card{opacity:1;transform:none}
  .cm-ways__title span{transform:none}
}
</style>

<section
  class="cm-ways"
  id="cm-ways-{{ section.id }}"
  data-cm-ways
  aria-labelledby="cm-ways-title-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="cm-ways__dots" aria-hidden="true">
    <span style="top:12%;left:6%;--s:10px;--t:17s"></span>
    <span style="top:30%;left:22%;--s:6px;--t:13s;--d:-4s"></span>
    <span style="top:8%;left:48%;--s:9px;--t:19s;--d:-7s"></span>
    <span style="top:22%;left:70%;--s:7px;--t:15s;--d:-2s"></span>
    <span style="top:14%;left:88%;--s:12px;--t:21s;--d:-9s"></span>
    <span style="top:58%;left:3%;--s:8px;--t:16s;--d:-5s"></span>
    <span style="top:84%;left:14%;--s:6px;--t:14s;--d:-11s"></span>
    <span style="top:92%;left:52%;--s:9px;--t:18s;--d:-3s"></span>
    <span style="top:66%;left:96%;--s:7px;--t:15s;--d:-8s"></span>
    <span style="top:88%;left:84%;--s:11px;--t:20s;--d:-6s"></span>
  </div>

  <div class="cm-ways__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="cm-ways__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="cm-ways__title" id="cm-ways-title-{{ section.id }}"><span>{{ section.settings.heading | escape }}</span></h2>
    {% endif %}

    <div class="cm-ways__grid">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          {% liquid
            assign art = block.settings.illustration
            if art == blank
              if block.settings.label == 'Prescriptions'
                assign art = 'rx'
              elsif block.settings.label == 'For Patients' or block.settings.label == 'For patients'
                assign art = 'patients'
              else
                assign art = 'shop'
              endif
            endif

            if block.settings.link != blank
              assign card_url = block.settings.link
            elsif art == 'rx'
              assign card_url = '/pages/prescriptions'
            elsif art == 'patients'
              assign card_url = '/pages/patients'
            elsif art == 'shop'
              assign card_url = routes.all_products_collection_url
            else
              assign card_url = routes.root_url
            endif

            assign open_label = block.settings.link_label | default: 'Open'
            assign open_label = open_label | replace: '→', '' | replace: '->', '' | strip
          %}
          <a class="cm-ways__card" href="{{ card_url }}" {{ block.shopify_attributes }}>
            <span class="cm-ways__bar" aria-hidden="true"></span>
            <div class="cm-ways__art" aria-hidden="true">
              {% case art %}
                {% when 'rx' %}
                  <svg viewBox="0 0 240 150">
                    <g class="stroke" stroke="#e0b8f0" stroke-width="7">
                      <path d="M123.5 25.1A50 50 0 0 1 169.9 71.5"/>
                      <path d="M169.9 78.5A50 50 0 0 1 123.5 124.9"/>
                      <path d="M116.5 124.9A50 50 0 0 1 70.1 78.5"/>
                      <path d="M70.1 71.5A50 50 0 0 1 116.5 25.1"/>
                    </g>
                    <g class="stroke" stroke="#9d3ec6" stroke-width="7">
                      <path class="a ring-seg s1" pathLength="1" d="M123.5 25.1A50 50 0 0 1 169.9 71.5"/>
                      <path class="a ring-seg s2" pathLength="1" d="M169.9 78.5A50 50 0 0 1 123.5 124.9"/>
                      <path class="a ring-seg s3" pathLength="1" d="M116.5 124.9A50 50 0 0 1 70.1 78.5"/>
                      <path class="a ring-seg s4" pathLength="1" d="M70.1 71.5A50 50 0 0 1 116.5 25.1"/>
                    </g>
                    <rect x="102" y="51" width="36" height="46" rx="6" fill="#fff" stroke="#7a28a0" stroke-width="2.5"/>
                    <g class="stroke" stroke="#9d3ec6" stroke-width="3">
                      <path class="a doc-line" style="--d:0s" d="M110 64h20"/>
                      <path class="a doc-line" style="--d:.15s" d="M110 74h20"/>
                      <path class="a doc-line" style="--d:.3s" d="M110 84h12"/>
                    </g>
                    <g class="a ring-check">
                      <circle cx="139" cy="52" r="11" fill="#7a28a0"/>
                      <path class="stroke" d="M134 52.5l3.4 3.4 6.4-6.8" stroke="#fff" stroke-width="2.6"/>
                    </g>
                  </svg>
                {% when 'patients' %}
                  <svg viewBox="0 0 240 150">
                    <g class="a chat-q">
                      <path d="M52 22h78a14 14 0 0 1 14 14v18a14 14 0 0 1-14 14H74l-14 12v-12h-8a14 14 0 0 1-14-14V36a14 14 0 0 1 14-14z" fill="#fff" stroke="#e0b8f0" stroke-width="2"/>
                      <path class="stroke" d="M84 37a7 7 0 1 1 9.6 6.5c-1.8.8-2.6 2-2.6 4" stroke="#9d3ec6" stroke-width="3.2"/>
                      <circle cx="91" cy="55" r="2.2" fill="#9d3ec6"/>
                    </g>
                    <g class="a chat-a">
                      <path d="M110 70h80a14 14 0 0 1 14 14v26a14 14 0 0 1-14 14h-4v12l-14-12h-62a14 14 0 0 1-14-14V84a14 14 0 0 1 14-14z" fill="#9d3ec6"/>
                      <g class="chat-dots" fill="#fff">
                        <circle style="--d:0s" cx="138" cy="97" r="4"/>
                        <circle style="--d:.15s" cx="150" cy="97" r="4"/>
                        <circle style="--d:.3s" cx="162" cy="97" r="4"/>
                      </g>
                      <g class="stroke" stroke="#fff" stroke-width="4">
                        <path class="a chat-line" style="--d:0s" d="M112 87h70"/>
                        <path class="a chat-line" style="--d:.25s" d="M112 98h56"/>
                        <path class="a chat-line" style="--d:.5s" d="M112 109h34"/>
                      </g>
                    </g>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 240 150">
                    <rect class="stroke" x="58" y="14" width="124" height="124" rx="10" stroke="#e0b8f0" stroke-width="2.5"/>
                    <path class="stroke" d="M58 54h124M58 96h124M58 138h124" stroke="#c850d1" stroke-width="3"/>
                    <g class="a shelf-item" style="--d:0s"><rect x="74" y="28" width="22" height="26" rx="5" fill="#7a28a0"/><rect x="79" y="22" width="12" height="7" rx="2" fill="#7a28a0"/></g>
                    <g class="a shelf-item" style="--d:.14s"><rect x="109" y="32" width="22" height="22" rx="5" fill="#7a28a0"/><rect x="114" y="26" width="12" height="7" rx="2" fill="#7a28a0"/></g>
                    <g class="a shelf-item" style="--d:.28s"><rect x="144" y="26" width="22" height="28" rx="5" fill="#7a28a0"/><rect x="149" y="20" width="12" height="7" rx="2" fill="#7a28a0"/></g>
                    <g class="a shelf-item" style="--d:.5s"><rect x="74" y="72" width="22" height="24" rx="5" fill="#9d3ec6"/><rect x="79" y="66" width="12" height="7" rx="2" fill="#9d3ec6"/></g>
                    <g class="a shelf-item" style="--d:.64s"><rect x="109" y="68" width="22" height="28" rx="5" fill="#9d3ec6"/><rect x="114" y="62" width="12" height="7" rx="2" fill="#9d3ec6"/></g>
                    <g class="a shelf-item" style="--d:.78s"><rect x="144" y="74" width="22" height="22" rx="5" fill="#9d3ec6"/><rect x="149" y="68" width="12" height="7" rx="2" fill="#9d3ec6"/></g>
                    <g class="a shelf-item" style="--d:1s"><rect x="74" y="112" width="22" height="26" rx="5" fill="#e0b8f0"/><rect x="79" y="106" width="12" height="7" rx="2" fill="#e0b8f0"/></g>
                    <g class="a shelf-item" style="--d:1.14s"><rect x="109" y="116" width="22" height="22" rx="5" fill="#e0b8f0"/><rect x="114" y="110" width="12" height="7" rx="2" fill="#e0b8f0"/></g>
                    <g class="a shelf-item" style="--d:1.28s"><rect x="144" y="110" width="22" height="28" rx="5" fill="#e0b8f0"/><rect x="149" y="104" width="12" height="7" rx="2" fill="#e0b8f0"/></g>
                  </svg>
              {% endcase %}
            </div>
            <div class="cm-ways__body">
              {% if block.settings.label != blank %}
                <span class="cm-ways__tag">{{ block.settings.label | escape }}</span>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="cm-ways__name">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <p class="cm-ways__text">{{ block.settings.body | escape }}</p>
              {% endif %}
              <span class="cm-ways__open">
                {{ open_label | escape }}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('cm-ways-{{ section.id }}');
  if (!root || root.dataset.cmWaysReady === '1') return;
  root.dataset.cmWaysReady = '1';

  function begin() {
    root.classList.add('is-in');
    root.classList.remove('is-paused');
  }

  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var on = entries[0].isIntersecting;
      if (on) begin();
      root.classList.toggle('is-paused', !on);
    }, { threshold: 0.2 }).observe(root);
  } else {
    begin();
  }

  setTimeout(function () {
    if (!root.classList.contains('is-in')) begin();
  }, 800);

  [].forEach.call(root.querySelectorAll('.cm-ways__card'), function (card) {
    card.addEventListener('pointermove', function (e) {
      var r = card.getBoundingClientRect();
      card.style.setProperty('--mx', e.clientX - r.left + 'px');
      card.style.setProperty('--my', e.clientY - r.top + 'px');
    });
  });
})();
</script>

{% schema %}
{
  "name": "CanMed — Ways in",
  "tag": "div",
  "class": "cm-section-ways",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Where to start"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three ways in."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "illustration",
          "label": "Illustration",
          "options": [
            { "value": "shop", "label": "Shop shelves" },
            { "value": "rx", "label": "Prescription ring" },
            { "value": "patients", "label": "Patient chat" }
          ],
          "default": "shop"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Compounded and stocked lines"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Browse by access tier: prescription only, pharmacist only, or over the counter."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Open"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CanMed — Ways in",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "illustration": "shop",
            "label": "Shop",
            "title": "Compounded and stocked lines",
            "body": "Browse by access tier: prescription only, pharmacist only, or over the counter.",
            "link_label": "Open"
          }
