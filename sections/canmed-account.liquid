{% comment %}
  CanMed My Account — prescriptions (intake orders) + order history + addresses
  Requires Customer Accounts enabled. Create a Page with template "account".
{% endcomment %}

{{ 'canmed-account.css' | asset_url | stylesheet_tag }}

{% assign account_page = section.settings.account_page_path | default: '/pages/my-account' %}
<section
  class="cm-account"
  data-cm-account
  data-cm-account-return="{{ account_page | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="cm-shell">
    {% if customer == blank %}
      <div class="cm-account__gate">
        {% if section.settings.eyebrow != blank %}
          <p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% comment %} New customer accounts: return_to sends the customer back to this page after sign-in {% endcomment %}
        <h1 class="cm-account__title">{{ section.settings.guest_heading | default: 'Sign in to see your prescriptions.' | escape }}</h1>
        <p class="cm-account__lede">
          {{ section.settings.guest_body | default: 'Sign in with the same email you use at checkout. Then this My Account page shows your prescriptions and orders.' | escape }}
        </p>
        <div class="cm-btn-row">
          <a
            class="cm-btn cm-btn--accent"
            href="/customer_authentication/login?return_to={{ account_page | url_encode }}"
          >
            {{ section.settings.login_label | default: 'Sign in' | escape }}
          </a>
          <a class="cm-btn cm-btn--secondary" href="{{ section.settings.prescriptions_link | default: '/pages/prescriptions' }}">
            {{ section.settings.start_rx_label | default: 'Start a prescription' | escape }}
          </a>
        </div>
      </div>
    {% else %}
      <header class="cm-account__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          <h1 class="cm-account__title">
            {% if customer.first_name != blank %}
              {{ customer.first_name | escape }}{% if customer.last_name != blank %} {{ customer.last_name | escape }}{% endif %}
            {% else %}
              {{ customer.email | escape }}
            {% endif %}
          </h1>
          <p class="cm-mono-data cm-account__meta">
            {{ customer.email | escape }}
            {% if customer.orders_count > 0 %}
              · {{ customer.orders_count }} order{% if customer.orders_count != 1 %}s{% endif %}
            {% endif %}
          </p>
        </div>
        <div class="cm-account__header-actions">
          <a class="cm-account__logout" href="{{ routes.account_logout_url }}">
            {{ section.settings.logout_label | default: 'Sign out' | escape }}
          </a>
        </div>
      </header>

      <div class="cm-account__grid">
        <div class="cm-account__main">
          <div data-cm-account-list>
          <h2 class="cm-account__heading">{{ section.settings.rx_heading | default: 'My prescriptions' | escape }}</h2>

          {% assign rx_count = 0 %}
          {% for order in customer.orders %}
            {% assign is_rx = false %}
            {% for line in order.line_items %}
              {% if line.properties['_rx_intake'] == 'true' or line.properties['_rx_intake'] == '1' %}
                {% assign is_rx = true %}
              {% endif %}
              {% if line.product.handle == 'prescription-submission' %}
                {% assign is_rx = true %}
              {% endif %}
              {% if line.title contains 'Prescription submission' or line.title contains 'Prescription Submission' %}
                {% assign is_rx = true %}
              {% endif %}
            {% endfor %}
            {% if is_rx %}
              {% assign rx_count = rx_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if rx_count == 0 %}
            <div class="cm-account__empty">
              <h3 class="cm-account__heading">{{ section.settings.empty_heading | default: 'Nothing here yet.' | escape }}</h3>
              <p class="cm-account__lede">
                {{ section.settings.empty_body | default: 'Start your first prescription and you will see every status change here, from received to dispatched.' | escape }}
              </p>
              <div class="cm-btn-row" style="justify-content:center;margin-top:1.75rem;">
                <a class="cm-btn cm-btn--accent" href="{{ section.settings.prescriptions_link | default: '/pages/prescriptions' }}">
                  {{ section.settings.start_rx_label | default: 'Start a prescription' | escape }}
                </a>
              </div>
            </div>
          {% else %}
            <ul class="cm-account__rx-list">
              {% for order in customer.orders %}
                {% assign is_rx = false %}
                {% assign rx_type = '' %}
                {% assign rx_dispensary = '' %}
                {% assign rx_status_raw = '' %}
                {% assign rx_notes = '' %}
                {% for line in order.line_items %}
                  {% if line.properties['_rx_intake'] == 'true' or line.properties['_rx_intake'] == '1' or line.product.handle == 'prescription-submission' or line.title contains 'Prescription submission' %}
                    {% assign is_rx = true %}
                    {% if line.properties['Prescription type'] != blank %}
                      {% assign rx_type = line.properties['Prescription type'] %}
                    {% endif %}
                    {% if line.properties['Dispensary'] != blank %}
                      {% assign rx_dispensary = line.properties['Dispensary'] %}
                    {% endif %}
                    {% if line.properties['Status'] != blank %}
                      {% assign rx_status_raw = line.properties['Status'] %}
                    {% endif %}
                    {% if line.properties['Notes'] != blank and line.properties['Notes'] != '—' %}
                      {% assign rx_notes = line.properties['Notes'] %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% if is_rx %}
                  {% include 'canmed-rx-status' %}
                  {% assign rx_updated = order.updated_at | default: order.created_at %}
                  {% assign rx_dom_id = 'cm-rx-' | append: order.id %}
                  <li class="cm-account__rx-item">
                    <div class="cm-account__rx-copy">
                      <p class="cm-account__rx-ref">
                        {{ order.name | default: order.order_number }}
                        {% if rx_dispensary != blank %} · {{ rx_dispensary | escape }}{% endif %}
                      </p>
                      <p class="cm-account__rx-title">
                        {% if rx_type != blank %}
                          {{ rx_type | escape }} prescription
                        {% else %}
                          Prescription request
                        {% endif %}
                      </p>
                      <p class="cm-account__rx-updated">
                        Updated {{ rx_updated | date: '%Y-%m-%d %H:%M' }}
                        {% if rx_notes != blank %} · {{ rx_notes | escape | truncate: 60 }}{% endif %}
                      </p>
                    </div>
                    <div class="cm-account__rx-actions">
                      <span class="cm-status-pill cm-status-pill--{{ status_tone }}" data-status="{{ status_key }}">
                        <span class="cm-status-pill__dot" aria-hidden="true"></span>
                        {{ status_label }}
                      </span>
                      <a
                        class="cm-account__track"
                        href="#{{ rx_dom_id }}"
                        data-cm-rx-open="{{ rx_dom_id }}"
                      >
                        {{ track_label | escape }}
                      </a>
                    </div>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}

          <h2 class="cm-account__heading cm-account__orders-heading">{{ section.settings.orders_heading | default: 'Order history' | escape }}</h2>

          {% assign shop_count = 0 %}
          {% for order in customer.orders %}
            {% assign is_rx = false %}
            {% for line in order.line_items %}
              {% if line.properties['_rx_intake'] == 'true' or line.properties['_rx_intake'] == '1' or line.product.handle == 'prescription-submission' or line.title contains 'Prescription submission' %}
                {% assign is_rx = true %}
              {% endif %}
            {% endfor %}
            {% unless is_rx %}
              {% assign shop_count = shop_count | plus: 1 %}
            {% endunless %}
          {% endfor %}

          {% if shop_count == 0 %}
            <p class="cm-mono-data cm-account__muted">{{ section.settings.orders_empty | default: 'No shop orders yet.' | escape }}</p>
          {% else %}
            <div class="cm-account__table-wrap">
              <table class="cm-account__table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Item</th>
                    <th>Total</th>
                    <th>Reorder</th>
                  </tr>
                </thead>
                <tbody>
                  {% for order in customer.orders %}
                    {% assign is_rx = false %}
                    {% for line in order.line_items %}
                      {% if line.properties['_rx_intake'] == 'true' or line.properties['_rx_intake'] == '1' or line.product.handle == 'prescription-submission' or line.title contains 'Prescription submission' %}
                        {% assign is_rx = true %}
                      {% endif %}
                    {% endfor %}
                    {% unless is_rx %}
                      {% assign first_line = order.line_items.first %}
                      <tr>
                        <td>{{ order.created_at | date: '%Y-%m-%d' }}</td>
                        <td>
                          {{ first_line.title | escape }}
                          {% if order.line_items.size > 1 %}
                            <span class="cm-account__muted">+{{ order.line_items.size | minus: 1 }} more</span>
                          {% endif %}
                        </td>
                        <td>{{ order.total_price | money }}</td>
                        <td>
                          {% if first_line.product.url != blank %}
                            <a class="cm-account__reorder" href="{{ first_line.product.url }}">Reorder</a>
                          {% else %}
                            <a class="cm-account__reorder" href="{{ order.customer_url }}">View</a>
                          {% endif %}
                        </td>
                      </tr>
                    {% endunless %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
          </div>{% comment %} /data-cm-account-list {% endcomment %}

          {% for order in customer.orders %}
            {% assign is_rx = false %}
            {% assign rx_type = '' %}
            {% assign rx_dispensary = '' %}
            {% assign rx_status_raw = '' %}
            {% assign rx_notes = '' %}
            {% assign rx_name = '' %}
            {% assign rx_email = '' %}
            {% assign rx_phone = '' %}
            {% assign rx_dob = '' %}
            {% assign rx_method = '' %}
            {% assign rx_address = '' %}
            {% assign rx_state = '' %}
            {% assign rx_script_name = '' %}
            {% assign rx_script_url = '' %}
            {% for line in order.line_items %}
              {% if line.properties['_rx_intake'] == 'true' or line.properties['_rx_intake'] == '1' or line.product.handle == 'prescription-submission' or line.title contains 'Prescription submission' %}
                {% assign is_rx = true %}
                {% if line.properties['Prescription type'] != blank %}{% assign rx_type = line.properties['Prescription type'] %}{% endif %}
                {% if line.properties['Dispensary'] != blank %}{% assign rx_dispensary = line.properties['Dispensary'] %}{% endif %}
                {% if line.properties['Status'] != blank %}{% assign rx_status_raw = line.properties['Status'] %}{% endif %}
                {% if line.properties['Notes'] != blank and line.properties['Notes'] != '—' %}{% assign rx_notes = line.properties['Notes'] %}{% endif %}
                {% if line.properties['Full name'] != blank %}{% assign rx_name = line.properties['Full name'] %}{% endif %}
                {% if line.properties['Email'] != blank %}{% assign rx_email = line.properties['Email'] %}{% endif %}
                {% if line.properties['Phone'] != blank %}{% assign rx_phone = line.properties['Phone'] %}{% endif %}
                {% if line.properties['Date of birth'] != blank %}{% assign rx_dob = line.properties['Date of birth'] %}{% endif %}
                {% if line.properties['Method'] != blank %}{% assign rx_method = line.properties['Method'] %}{% endif %}
                {% if line.properties['Delivery address'] != blank %}{% assign rx_address = line.properties['Delivery address'] %}{% endif %}
                {% if line.properties['State'] != blank %}{% assign rx_state = line.properties['State'] %}{% endif %}
                {% if line.properties['Script file name'] != blank %}{% assign rx_script_name = line.properties['Script file name'] %}{% endif %}
                {% if line.properties['Script attachment'] != blank %}{% assign rx_script_url = line.properties['Script attachment'] %}{% endif %}
                {% if line.properties['Script file URL'] != blank %}{% assign rx_script_url = line.properties['Script file URL'] %}{% endif %}
              {% endif %}
            {% endfor %}

            {% if is_rx %}
              {% include 'canmed-rx-status' %}
              {% assign rx_updated = order.updated_at | default: order.created_at %}
              {% assign rx_dom_id = 'cm-rx-' | append: order.id %}
              <article class="cm-account__detail" data-cm-rx-detail="{{ rx_dom_id }}" id="{{ rx_dom_id }}" hidden>
                <button type="button" class="cm-account__back" data-cm-rx-back>
                  ← Back to prescriptions
                </button>
                <div class="cm-account__detail-head">
                  <div>
                    <p class="cm-eyebrow">Prescription</p>
                    <h2 class="cm-account__title">
                      {% if rx_type != blank %}{{ rx_type | escape }} prescription{% else %}Prescription request{% endif %}
                    </h2>
                    <p class="cm-account__meta">
                      {{ order.name | default: order.order_number }}
                      {% if rx_dispensary != blank %} · {{ rx_dispensary | escape }}{% endif %}
                      · Updated {{ rx_updated | date: '%Y-%m-%d %H:%M' }}
                    </p>
                  </div>
                  <span class="cm-status-pill cm-status-pill--{{ status_tone }}" data-status="{{ status_key }}">
                    <span class="cm-status-pill__dot" aria-hidden="true"></span>
                    {{ status_label }}
                  </span>
                </div>

                <dl class="cm-account__facts">
                  {% if rx_name != blank %}
                    <div><dt>Patient</dt><dd>{{ rx_name | escape }}</dd></div>
                  {% endif %}
                  {% if rx_email != blank %}
                    <div><dt>Email</dt><dd>{{ rx_email | escape }}</dd></div>
                  {% endif %}
                  {% if rx_phone != blank %}
                    <div><dt>Phone</dt><dd>{{ rx_phone | escape }}</dd></div>
                  {% endif %}
                  {% if rx_dob != blank %}
                    <div><dt>Date of birth</dt><dd>{{ rx_dob | escape }}</dd></div>
                  {% endif %}
                  {% if rx_method != blank %}
                    <div><dt>Method</dt><dd>{{ rx_method | escape }}</dd></div>
                  {% endif %}
                  {% if rx_address != blank %}
                    <div><dt>Delivery</dt><dd>{{ rx_address | escape }}{% if rx_state != blank and rx_state != 'N/A (pickup)' %} · {{ rx_state | escape }}{% endif %}</dd></div>
                  {% endif %}
                  {% if rx_dispensary != blank %}
                    <div><dt>Dispensary</dt><dd>{{ rx_dispensary | escape }}</dd></div>
                  {% endif %}
                  {% if rx_type != blank %}
                    <div><dt>Type</dt><dd>{{ rx_type | escape }}</dd></div>
                  {% endif %}
                  {% if rx_notes != blank %}
                    <div><dt>Notes</dt><dd>{{ rx_notes | escape }}</dd></div>
                  {% endif %}
                  {% if rx_script_name != blank or rx_script_url != blank %}
                    <div>
                      <dt>Script</dt>
                      <dd>
                        {% if rx_script_url != blank %}
                          <a class="cm-account__aside-link" href="{{ rx_script_url }}" target="_blank" rel="noopener">
                            {{ rx_script_name | default: 'Open script attachment' | escape }}
                          </a>
                        {% else %}
                          {{ rx_script_name | escape }}
                        {% endif %}
                      </dd>
                    </div>
                  {% endif %}
                </dl>

                {% if status_key == 'cancelled' %}
                  <p class="cm-account__detail-note">This request was cancelled. Contact the pharmacy if you need to submit again.</p>
                  <div class="cm-btn-row" style="margin-top:1.5rem;">
                    <a class="cm-btn cm-btn--accent" href="{{ section.settings.prescriptions_link | default: '/pages/prescriptions' }}">Start a new prescription</a>
                  </div>
                {% else %}
                  <p class="cm-account__detail-note">A pharmacist will update this status as your request moves from received to dispatched.</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}

          {% comment %} No hash in return_to — Shopify New Accounts can ignore/break fragment URLs. {% endcomment %}
          {% assign addresses_return = section.settings.account_page_path | default: '/pages/my-account' %}
          {% assign addresses_return_hash = addresses_return | append: '#cm-addresses' %}
          <article class="cm-account__detail" data-cm-rx-detail="cm-addresses" id="cm-addresses" hidden>
            <button type="button" class="cm-account__back" data-cm-rx-back>
              ← Back to prescriptions
            </button>
            <div class="cm-account__detail-head">
              <div>
                <p class="cm-eyebrow">My account</p>
                <h2 class="cm-account__title">{{ section.settings.addresses_heading | default: 'Saved addresses' | escape }}</h2>
                <p class="cm-account__lede">
                  {{ section.settings.addresses_detail_body | default: 'Add, edit, or remove delivery addresses for checkout.' | escape }}
                </p>
              </div>
              <button type="button" class="cm-account__track" data-cm-addr-toggle="new">
                Add address
              </button>
            </div>

            <div class="cm-account__addr-form" data-cm-addr-panel="new" hidden>
              <h3 class="cm-account__heading">Add a new address</h3>
              {% form 'customer_address', customer.new_address, return_to: addresses_return %}
                {% if form.errors != blank %}
                  <p class="cm-account__form-error" role="alert">{{ form.errors | default_errors }}</p>
                {% endif %}
                {% render 'canmed-address-fields', form: form, id_prefix: 'new' %}
                <div class="cm-btn-row" style="margin-top:1.25rem;">
                  <button type="submit" class="cm-btn cm-btn--accent">Save address</button>
                  <button type="button" class="cm-btn cm-btn--secondary" data-cm-addr-cancel="new">Cancel</button>
                </div>
              {% endform %}
            </div>

            {% if customer.addresses_count == 0 %}
              <div class="cm-account__empty" style="margin-top:1.5rem;" data-cm-addr-empty>
                <h3 class="cm-account__heading">No saved addresses yet.</h3>
                <p class="cm-account__lede">Add one above, or it will appear after your next delivery checkout.</p>
              </div>
            {% else %}
              <div class="cm-account__addresses cm-account__addresses--detail">
                {% for address in customer.addresses %}
                  <div class="cm-account__card{% if address == customer.default_address %} is-default{% endif %}" data-cm-addr-card="{{ address.id }}">
                    <div class="cm-account__addr-card-top">
                      <p class="cm-mono-caption">
                        {% if address == customer.default_address %}Default{% elsif address.company != blank %}{{ address.company | escape }}{% else %}Address{% endif %}
                      </p>
                      <div class="cm-account__addr-actions">
                        <button type="button" class="cm-account__addr-action" data-cm-addr-toggle="{{ address.id }}">Edit</button>
                        {% comment %}
                          Do not use {% form 'customer_address' %} for delete — Shopify injects _method=put,
                          which overrides delete and lands on a blank/broken page.
                        {% endcomment %}
                        <form
                          method="post"
                          action="{{ address.url }}"
                          accept-charset="UTF-8"
                          data-cm-addr-form
                          data-cm-addr-return="{{ addresses_return_hash }}"
                        >
                          <input type="hidden" name="form_type" value="customer_address">
                          <input type="hidden" name="utf8" value="✓">
                          <input type="hidden" name="_method" value="delete">
                          <input type="hidden" name="return_to" value="{{ addresses_return }}">
                          <button
                            type="submit"
                            class="cm-account__addr-action cm-account__addr-action--danger"
                            data-cm-addr-delete
                            data-confirm="Delete this address?"
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </div>
                    <div data-cm-addr-summary="{{ address.id }}">
                      <p class="cm-mono-data">
                        {% if address.name != blank %}{{ address.name | escape }}<br>{% endif %}
                        {{ address.address1 | escape }}
                        {% if address.address2 != blank %}<br>{{ address.address2 | escape }}{% endif %}
                        <br>
                        {{ address.city | escape }}
                        {% if address.province_code != blank %} {{ address.province_code | escape }}{% endif %}
                        {{ address.zip | escape }}
                        {% if address.country != blank %}<br>{{ address.country | escape }}{% endif %}
                        {% if address.phone != blank %}<br>{{ address.phone | escape }}{% endif %}
                      </p>
                    </div>

                    <div class="cm-account__addr-form" data-cm-addr-panel="{{ address.id }}" hidden>
                      <h3 class="cm-account__heading">Edit address</h3>
                      {% form 'customer_address', address, return_to: addresses_return %}
                        {% if form.errors != blank %}
                          <p class="cm-account__form-error" role="alert">{{ form.errors | default_errors }}</p>
                        {% endif %}
                        {% render 'canmed-address-fields', form: form, id_prefix: address.id %}
                        <div class="cm-btn-row" style="margin-top:1.25rem;">
                          <button type="submit" class="cm-btn cm-btn--accent">Update address</button>
                          <button type="button" class="cm-btn cm-btn--secondary" data-cm-addr-cancel="{{ address.id }}">Cancel</button>
                        </div>
                      {% endform %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </article>
        </div>

        <aside class="cm-account__aside">
          <h2 class="cm-account__heading">{{ section.settings.addresses_heading | default: 'Saved addresses' | escape }}</h2>
          {% if customer.addresses_count == 0 %}
            <p class="cm-mono-data cm-account__muted">{{ section.settings.addresses_empty | default: 'No saved addresses yet. They appear after checkout.' | escape }}</p>
            <button type="button" class="cm-btn cm-btn--secondary" style="margin-top:1rem;" data-cm-rx-open="cm-addresses">
              {{ section.settings.manage_addresses_label | default: 'Manage addresses' | escape }}
            </button>
          {% else %}
            <div class="cm-account__addresses">
              {% for address in customer.addresses %}
                <div class="cm-account__card{% if address == customer.default_address %} is-default{% endif %}">
                  <p class="cm-mono-caption">
                    {% if address == customer.default_address %}Home{% else %}Address{% endif %}
                  </p>
                  <p class="cm-mono-data">
                    {{ address.address1 | escape }}
                    {% if address.address2 != blank %}<br>{{ address.address2 | escape }}{% endif %}
                    <br>
                    {{ address.city | escape }}
                    {% if address.province_code != blank %} {{ address.province_code | escape }}{% endif %}
                    {{ address.zip | escape }}
                  </p>
                </div>
              {% endfor %}
            </div>
            <button type="button" class="cm-mono-data cm-account__aside-link" data-cm-rx-open="cm-addresses">
              {{ section.settings.manage_addresses_label | default: 'Manage addresses' | escape }}
            </button>
          {% endif %}

          <h2 class="cm-account__heading cm-account__aside-heading">{{ section.settings.clinic_heading | default: 'Your dispensary' | escape }}</h2>
          <div class="cm-account__card">
            <p class="cm-mono-caption cm-account__clinic-name">{{ section.settings.clinic_name | default: 'CanMED West Lakes Clinic' | escape }}</p>
            <p class="cm-mono-data">
              {{ section.settings.clinic_address | default: 'Unit 5, 151 Brebner Drive, West Lakes SA 5021' | escape }}
            </p>
            {% if section.settings.clinic_phone != blank %}
              <a class="cm-mono-data cm-account__aside-link" href="tel:{{ section.settings.clinic_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' }}">
                {{ section.settings.clinic_phone | escape }}
              </a>
            {% endif %}
          </div>
        </aside>
      </div>
    {% endif %}
  </div>
</section>

<script src="{{ 'canmed-account.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CanMed — My Account",
  "tag": "section",
  "class": "cm-section-account",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "My account" },
    { "type": "text", "id": "guest_heading", "label": "Guest heading", "default": "Sign in to see your prescriptions." },
    {
      "type": "textarea",
      "id": "guest_body",
      "label": "Guest body",
      "default": "Sign in with the same email you use at checkout. Then this My Account page shows your prescriptions and orders."
    },
    {
      "type": "text",
      "id": "account_page_path",
      "label": "My Account page path",
      "default": "/pages/my-account",
      "info": "Used after sign-in (return_to). Keep as /pages/my-account."
    },
    { "type": "text", "id": "login_label", "label": "Sign in label", "default": "Sign in" },
    { "type": "text", "id": "logout_label", "label": "Sign out label", "default": "Sign out" },
    { "type": "text", "id": "rx_heading", "label": "Prescriptions heading", "default": "My prescriptions" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing here yet." },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "Start your first prescription and you will see every status change here, from received to dispatched." },
    { "type": "text", "id": "start_rx_label", "label": "Start prescription CTA", "default": "Start a prescription" },
    { "type": "url", "id": "prescriptions_link", "label": "Prescriptions page" },
    { "type": "text", "id": "track_label", "label": "Track / view label", "default": "Track" },
    { "type": "text", "id": "orders_heading", "label": "Orders heading", "default": "Order history" },
    { "type": "text", "id": "orders_empty", "label": "Orders empty", "default": "No shop orders yet." },
    { "type": "text", "id": "addresses_heading", "label": "Addresses heading", "default": "Saved addresses" },
