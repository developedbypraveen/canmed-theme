{% comment %}
  CanMed Shop — tier tabs (Prescription / S3 / OTC) matching Lovable /shop
  Pulls products from the three smart collections created in Admin.
{% endcomment %}

<section class="cm-shop" data-cm-shop {{ section.shopify_attributes }}>
  <div class="cm-shell cm-shop__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="cm-display-l">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="cm-body-l cm-shop__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </div>

  {% liquid
    assign col_rx = section.settings.collection_rx
    assign col_s3 = section.settings.collection_s3
    assign col_otc = section.settings.collection_otc
    if col_rx == blank
      assign col_rx = collections['prescription-only']
    endif
    if col_s3 == blank
      assign col_s3 = collections['s3-pharmacist-only']
    endif
    if col_otc == blank
      assign col_otc = collections['over-the-counter']
    endif
  %}

  <div class="cm-shop__bar">
    <div class="cm-shell cm-shop__bar-inner">
      <div class="cm-shop__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | default: 'Access tier' | escape }}">
        <button type="button" class="cm-shop__tab is-active" role="tab" aria-selected="true" data-cm-shop-tier="prescription">
          <span class="cm-shop__tab-dot cm-shop__tab-dot--rx"></span>
          {{ section.settings.label_rx | default: 'Prescription Only' | escape }}
        </button>
        <button type="button" class="cm-shop__tab" role="tab" aria-selected="false" data-cm-shop-tier="s3">
          <span class="cm-shop__tab-dot cm-shop__tab-dot--s3"></span>
          {{ section.settings.label_s3 | default: 'S3 Pharmacist Only' | escape }}
        </button>
        <button type="button" class="cm-shop__tab" role="tab" aria-selected="false" data-cm-shop-tier="otc">
          <span class="cm-shop__tab-dot cm-shop__tab-dot--otc"></span>
          {{ section.settings.label_otc | default: 'Over the Counter' | escape }}
        </button>
      </div>
      <label class="cm-shop__sort cm-mono-data">
        {{ section.settings.sort_label | default: 'Sort' | escape }}
        <select data-cm-shop-sort>
          <option value="manual">{{ section.settings.sort_popularity | default: 'Popularity' | escape }}</option>
          <option value="price-asc">{{ section.settings.sort_price | default: 'Price' | escape }}</option>
          <option value="title-asc">{{ section.settings.sort_latest | default: 'Name' | escape }}</option>
        </select>
      </label>
    </div>
  </div>

  <div class="cm-shell cm-shop__panels">
    {% assign tiers = 'prescription,s3,otc' | split: ',' %}
    {% for tier in tiers %}
      {% liquid
        case tier
          when 'prescription'
            assign panel_col = col_rx
            assign panel_note = section.settings.note_rx | default: 'Requires a valid script from your prescriber before we dispense.'
          when 's3'
            assign panel_col = col_s3
            assign panel_note = section.settings.note_s3 | default: 'No script needed — a pharmacist speaks with you before supply.'
          else
            assign panel_col = col_otc
            assign panel_note = section.settings.note_otc | default: 'Order online or check availability at your nearest CanMed dispensary.'
        endcase
      %}
      <div
        class="cm-shop__panel"
        role="tabpanel"
        data-cm-shop-panel="{{ tier }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <p class="cm-mono-data cm-shop__note">{{ panel_note | escape }}</p>

        {% if panel_col == blank or panel_col.products_count == 0 %}
          <div class="cm-shop__empty">
            <h3 class="cm-display-m">{{ section.settings.empty_heading | default: 'Nothing in this tier yet.' | escape }}</h3>
            <p>{{ section.settings.empty_body | default: "Try another access tier, or tell us what you need and we'll quote a compound." | escape }}</p>
            <a class="cm-mono-data cm-shop__empty-link" href="{{ section.settings.empty_link | default: '/pages/contact' }}">
              {{ section.settings.empty_cta | default: 'Ask a pharmacist →' | escape }}
            </a>
          </div>
        {% else %}
          <div class="cm-shop__grid" data-cm-shop-grid>
            {% for product in panel_col.products %}
              {% liquid
                assign tier_key = tier
                assign mf_tier = product.metafields.canmed.access_tier.value | default: product.metafields.canmed.access_tier
                if mf_tier != blank
                  assign tier_key = mf_tier
                endif
                assign descriptor = product.metafields.canmed.descriptor.value | default: product.metafields.canmed.descriptor | default: product.description | strip_html | truncate: 120
                assign form_label = product.metafields.canmed.form.value | default: product.metafields.canmed.form | default: product.type
                assign base_sku = product.metafields.canmed.base_sku.value | default: product.metafields.canmed.base_sku | default: product.selected_or_first_available_variant.sku
                assign price_cents = product.price
              %}
              <a
                class="cm-shop-card"
                href="{{ product.url }}"
                data-cm-shop-card
                data-price="{{ price_cents }}"
                data-title="{{ product.title | escape }}"
              >
                <div class="cm-shop-card__media cm-shop-card__media--{{ tier_key }}">
                  {% if product.featured_media %}
                    {{
                      product.featured_media
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 900',
                        sizes: '(min-width: 768px) 30vw, 100vw',
                        class: 'cm-shop-card__img',
                        alt: product.featured_media.alt | default: product.title
                    }}
                  {% else %}
                    <span class="cm-mono-caption">{{ form_label | escape }}</span>
                    <span class="cm-mono-data">{{ base_sku | escape }}</span>
                  {% endif %}
                </div>
                <div class="cm-shop-card__body">
                  <h3 class="cm-shop-card__title">{{ product.title | escape }}</h3>
                  {% if descriptor != blank %}
                    <p class="cm-shop-card__desc">{{ descriptor | escape }}</p>
                  {% endif %}
                  <div class="cm-shop-card__meta">
                    <span class="cm-mono-data">{{ product.price | money }}</span>
                    <span class="cm-mono-data cm-shop-card__muted">{{ product.variants.size }} {% if product.variants.size == 1 %}size{% else %}sizes{% endif %}</span>
                  </div>
                  <div class="cm-shop-card__variants">
                    {% for variant in product.variants limit: 6 %}
                      <span class="cm-shop-card__pill">{{ variant.title | escape }}</span>
                    {% endfor %}
                  </div>
                </div>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<script src="{{ 'canmed-shop.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CanMed — Shop",
  "tag": "section",
  "class": "cm-section-shop",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything we make, sorted by how you can get it." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Access differs by schedule, so we lead with that rather than hiding it at checkout." },
    { "type": "text", "id": "tabs_label", "label": "Tabs aria label", "default": "Access tier" },
    { "type": "text", "id": "label_rx", "label": "Tab — Prescription", "default": "Prescription Only" },
    { "type": "text", "id": "label_s3", "label": "Tab — S3", "default": "S3 Pharmacist Only" },
    { "type": "text", "id": "label_otc", "label": "Tab — OTC", "default": "Over the Counter" },
    { "type": "textarea", "id": "note_rx", "label": "Note — Prescription", "default": "Requires a valid script from your prescriber before we dispense." },
    { "type": "textarea", "id": "note_s3", "label": "Note — S3", "default": "No script needed — a pharmacist speaks with you before supply." },
    { "type": "textarea", "id": "note_otc", "label": "Note — OTC", "default": "Order online or check availability at your nearest CanMed dispensary." },
    { "type": "collection", "id": "collection_rx", "label": "Collection — Prescription Only" },
    { "type": "collection", "id": "collection_s3", "label": "Collection — S3 Pharmacist Only" },
    { "type": "collection", "id": "collection_otc", "label": "Collection — Over the Counter" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Sort" },
    { "type": "text", "id": "sort_popularity", "label": "Sort option — popularity", "default": "Popularity" },
    { "type": "text", "id": "sort_price", "label": "Sort option — price", "default": "Price" },
    { "type": "text", "id": "sort_latest", "label": "Sort option — name", "default": "Name" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing in this tier yet." },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "Try another access tier, or tell us what you need and we'll quote a compound." },
    { "type": "text", "id": "empty_cta", "label": "Empty CTA", "default": "Ask a pharmacist →" },
    { "type": "url", "id": "empty_link", "label": "Empty CTA link" }
  ],
  "presets": [{ "name": "CanMed — Shop" }]
}
{% endschema %}
