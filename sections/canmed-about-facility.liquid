<section class="cm-section" {{ section.shopify_attributes }}>
  <div class="cm-shell">
    {% if section.settings.eyebrow != blank %}<p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="cm-display-l" style="margin-top:1rem;">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.paragraph_1 != blank %}<p class="cm-body-l" style="margin-top:1rem;max-width:46rem;">{{ section.settings.paragraph_1 | escape }}</p>{% endif %}
    {% if section.settings.paragraph_2 != blank %}<p class="cm-body-l" style="margin-top:1rem;max-width:46rem;">{{ section.settings.paragraph_2 | escape }}</p>{% endif %}
    <ul class="cm-info-cards" style="list-style:none;padding:0;">
      {% if section.settings.chip_1 != blank %}<li class="cm-info-card">{{ section.settings.chip_1 | escape }}</li>{% endif %}
      {% if section.settings.chip_2 != blank %}<li class="cm-info-card">{{ section.settings.chip_2 | escape }}</li>{% endif %}
      {% if section.settings.chip_3 != blank %}<li class="cm-info-card">{{ section.settings.chip_3 | escape }}</li>{% endif %}
    </ul>
    {% if section.settings.closing != blank %}<p class="cm-body-l" style="margin-top:1.5rem;">{{ section.settings.closing | escape }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CanMed — Where it's made",
  "tag": "section",
  "class": "cm-section-facility",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where it's made" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made here in Adelaide, not shipped in" },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraph 1" },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraph 2" },
    { "type": "text", "id": "chip_1", "label": "Fact 1" },
    { "type": "text", "id": "chip_2", "label": "Fact 2" },
    { "type": "text", "id": "chip_3", "label": "Fact 3" },
    { "type": "textarea", "id": "closing", "label": "Closing line" }
  ],
  "presets": [{ "name": "CanMed — Where it's made" }]
}
{% endschema %}
