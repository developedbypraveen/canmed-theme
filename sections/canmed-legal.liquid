<section class="cm-legal" {{ section.shopify_attributes }}>
  <div class="cm-shell">
    <div class="cm-legal__inner">
      {% if section.settings.eyebrow != blank %}<p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="cm-display-l">{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.updated != blank %}<p class="cm-mono-data cm-legal__updated" style="color:var(--cm-muted);">{{ section.settings.updated | escape }}</p>{% endif %}
      {% if section.settings.intro != blank %}<p class="cm-body-l cm-legal__intro">{{ section.settings.intro | escape }}</p>{% endif %}
      <div class="cm-legal__sections">
        {% for block in section.blocks %}
          <div class="cm-legal__section" {{ block.shopify_attributes }}>
            <h2 class="cm-display-m">{{ block.settings.title | escape }}</h2>
            <p>{{ block.settings.body | escape }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CanMed — Legal",
  "tag": "section",
  "class": "cm-section-legal",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Legal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Privacy Policy" },
    { "type": "text", "id": "updated", "label": "Last updated", "default": "Last updated 1 August 2026" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "CanMed Compounding Chemist handles health information under the Privacy Act 1988 (Cth) and the Australian Privacy Principles." }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "What we collect" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Your name, date of birth, contact details, and the prescriptions you upload." }
      ]
    }
  ],
  "presets": [{ "name": "CanMed — Legal" }]
}
{% endschema %}
