<section class="cm-pro-banner{% if section.settings.tone == 'dark' %} cm-pro-banner--dark{% endif %}" {{ section.shopify_attributes }}>
  <div class="cm-shell cm-pro-banner__grid">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="cm-mono-caption">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="cm-display-l">{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.body != blank %}<p class="cm-pro-banner__lede">{{ section.settings.body | escape }}</p>{% endif %}
    </div>
    <div>
      {% if section.settings.show_icon %}
        <div class="cm-pro-banner__icon" aria-hidden="true">{% render 'canmed-icon-veterinary' %}</div>
      {% else %}
        <div class="cm-pro-facts">
          {% for block in section.blocks %}
            {% if block.type == 'fact' %}
              <div class="cm-pro-fact" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label | escape }}</span>
                <strong>{{ block.settings.value | escape }}</strong>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CanMed — Pro banner",
  "tag": "section",
  "class": "cm-section-pro-banner",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "tone", "label": "Tone", "default": "pine",
      "options": [
        { "value": "pine", "label": "Pine" },
        { "value": "dark", "label": "Pine dark" }
      ]
    },
    { "type": "checkbox", "id": "show_icon", "label": "Show veterinary icon instead of facts", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For medical professionals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formulary, ranges, turnaround." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Direct ordering for registered prescribers. Scripts received before 11:00 are triaged the same day." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Prescriber line" },
        { "type": "text", "id": "value", "label": "Value", "default": "(03) 9818 7750" }
      ]
    }
  ],
  "presets": [{ "name": "CanMed — Pro banner" }]
}
{% endschema %}
