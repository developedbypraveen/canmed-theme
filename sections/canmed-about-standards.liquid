{% comment %} CanMed — About standards (approved HTML interactive bench) {% endcomment %}
{{ 'canmed-about.css' | asset_url | stylesheet_tag }}

<section
  class="cm-au-std"
  data-reveal
  data-cm-std
  aria-labelledby="cm-au-std-title-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="cm-au-std__wash" aria-hidden="true"></div>
  <div class="cm-au__shell cm-au-std__shell">
    <div class="cm-au-std__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="cm-au-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="cm-au-std__title" id="cm-au-std-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.lead != blank %}
        <p class="cm-au-std__lead">{{ section.settings.lead | escape }}</p>
      {% endif %}
    </div>

    {% assign first_block = nil %}
    {% for block in section.blocks %}
      {% if block.type == 'step' and first_block == nil %}
        {% assign first_block = block %}
      {% endif %}
    {% endfor %}

    <div class="cm-au-std__bench" style="--step:0">
      <div class="cm-au-std__stage" aria-live="polite">
        <div class="cm-au-std__stage-top">
          <p class="cm-au-std__stage-kicker"><i></i> {{ section.settings.stage_kicker | default: 'On the bench' | escape }}</p>
          <p class="cm-au-std__stage-num" data-std-num>{{ first_block.settings.num | default: '01' | escape }}</p>
          <div class="cm-au-std__stage-icon" data-std-icon aria-hidden="true">
            <svg viewBox="0 0 24 24">{{ first_block.settings.icon_paths }}</svg>
          </div>
        </div>
        <div class="cm-au-std__stage-body">
          <h3 class="cm-au-std__stage-name" data-std-name>{{ first_block.settings.name | default: 'Read properly' | escape }}</h3>
          <p class="cm-au-std__stage-copy" data-std-copy>{{ first_block.settings.copy | escape }}</p>
          <div class="cm-au-std__progress" aria-hidden="true"><i></i></div>
        </div>
      </div>

      <div class="cm-au-std__list" role="list">
        {% assign step_i = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <button
              class="cm-au-std__item{% if step_i == 0 %} is-on{% endif %}"
              type="button"
              role="listitem"
              style="--i:{{ step_i }}"
              data-std-step="{{ step_i }}"
              data-std-num="{{ block.settings.num | escape }}"
              data-std-name="{{ block.settings.name | escape }}"
              data-std-copy="{{ block.settings.copy | escape }}"
              data-std-icon="{{ block.settings.icon_paths | escape }}"
              aria-pressed="{% if step_i == 0 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="cm-au-std__item-num">{{ block.settings.num | default: '01' | escape }}</span>
              <span>
                <span class="cm-au-std__item-name">{{ block.settings.name | escape }}</span>
                {% if block.settings.hint != blank %}
                  <span class="cm-au-std__item-hint">{{ block.settings.hint | escape }}</span>
                {% endif %}
              </span>
              <span class="cm-au-std__item-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </span>
            </button>
            {% assign step_i = step_i | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'canmed-about.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CanMed — About standards",
  "tag": "section",
  "class": "cm-section-about-standards",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same care, every script." },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Whether you visit West Lakes or King William Street, the compounding bench follows the same discipline."
    },
    { "type": "text", "id": "stage_kicker", "label": "Stage kicker", "default": "On the bench" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "num", "label": "Number", "default": "01" },
        { "type": "text", "id": "name", "label": "Name", "default": "Read properly" },
        { "type": "text", "id": "hint", "label": "List hint", "default": "Dose, form, clinical sense" },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Description",
          "default": "Every script is checked for dose, form, and clinical sense before anything is weighed."
        },
        {
          "type": "textarea",
          "id": "icon_paths",
          "label": "Icon SVG paths",
          "default": "<path d=\"M4 6h16\"/><path d=\"M4 12h10\"/><path d=\"M4 18h14\"/><path d=\"m15 10 2 2 4-4\"/>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CanMed — About standards",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "num": "01",
            "name": "Read properly",
            "hint": "Dose, form, clinical sense",
            "copy": "Every script is checked for dose, form, and clinical sense before anything is weighed.",
            "icon_paths": "<path d=\"M4 6h16\"/><path d=\"M4 12h10\"/><path d=\"M4 18h14\"/><path d=\"m15 10 2 2 4-4\"/>"
          }
        },
        {
          "type": "step",
          "settings": {
            "num": "02",
            "name": "Weigh accurately",
            "hint": "Calibrated balances, on site",
            "copy": "Measured on calibrated balances — not scooped, guessed, or batched off-site.",
            "icon_paths": "<path d=\"M12 3v14\"/><path d=\"M8 21h8\"/><path d=\"M5 7h14\"/><path d=\"M7 7 4.8 12.2a2.2 2.2 0 0 0 2 3.1H8\"/><path d=\"M17 7l2.2 5.2a2.2 2.2 0 0 1-2 3.1H16\"/>"
          }
        },
        {
          "type": "step",
          "settings": {
            "num": "03",
            "name": "Label clearly",
            "hint": "Plain language directions",
            "copy": "Directions a person can follow at home — strength, timing, and storage in plain language.",
            "icon_paths": "<rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"2\"/><path d=\"M8 9h8\"/><path d=\"M8 13h5\"/>"
          }
        },
        {
          "type": "step",
          "settings": {
            "num": "04",
            "name": "Explain personally",
            "hint": "Pharmacist to patient",
            "copy": "A pharmacist reviews the finished medicine and talks it through with the person taking it.",
            "icon_paths": "<path d=\"M4 19c2-4 5-6 8-6s6 2 8 6\"/><circle cx=\"12\" cy=\"8\" r=\"3.5\"/>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
