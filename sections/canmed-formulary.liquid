<section class="cm-section" {{ section.shopify_attributes }}>
  <div class="cm-shell">
    <div class="cm-pro-toolbar">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="cm-display-m" style="margin-top:0.75rem;">{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
      <div class="cm-btn-row">
        {% if section.settings.secondary_label != blank %}
          <a class="cm-btn cm-btn--secondary" href="{{ section.settings.secondary_link | default: '/pages/professionals-vets' }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
        {% if section.settings.primary_label != blank %}
          <a class="cm-btn cm-btn--accent" href="{{ section.settings.primary_link | default: '/pages/contact' }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
      </div>
    </div>

    <div class="cm-table-wrap">
      <table class="cm-table">
        <thead>
          <tr>
            {% assign heads = section.settings.columns | default: 'Code,Form,Base,Range,Turnaround,Site' | split: ',' %}
            {% for h in heads %}<th>{{ h | strip | escape }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.c1 | escape }}</td>
                <td>{{ block.settings.c2 | escape }}</td>
                <td>{{ block.settings.c3 | escape }}</td>
                <td>{{ block.settings.c4 | escape }}</td>
                <td>{{ block.settings.c5 | escape }}</td>
                <td>{{ block.settings.c6 | escape }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if section.settings.show_pharmacists %}
      <div class="cm-pro-locs">
        {% for block in section.blocks %}
          {% if block.type == 'pharmacist' %}
            <div class="cm-info-card" {{ block.shopify_attributes }}>
              <p class="cm-mono-caption">{{ block.settings.location | escape }}</p>
              <p class="cm-mono-data" style="margin-top:0.75rem;">{{ block.settings.name | escape }}</p>
              <p class="cm-mono-data" style="color:var(--cm-muted);">{{ block.settings.credential | escape }}</p>
              <a class="cm-locations__phone" href="{{ block.settings.phone_link }}">{{ block.settings.phone | escape }}</a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% assign pathways = section.blocks | where: 'type', 'pathway' %}
    {% if pathways.size > 0 %}
      <div class="cm-pro-pathway">
        {% for block in pathways %}
          <div {{ block.shopify_attributes }}>
            <p class="cm-mono-caption" style="color:var(--cm-muted);">{{ block.settings.title | escape }}</p>
            <p class="cm-mono-data" style="margin-top:0.5rem;">{{ block.settings.body | escape }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CanMed — Formulary",
  "tag": "section",
  "class": "cm-section-formulary",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Base formulary" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Standard bases and ranges" },
    { "type": "text", "id": "columns", "label": "Column headers (comma-separated)", "default": "Code,Form,Base,Range,Turnaround,Site" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA", "default": "For vets" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA", "default": "Open a prescriber account" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "checkbox", "id": "show_pharmacists", "label": "Show pharmacist cards", "default": true }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        { "type": "text", "id": "c1", "label": "Col 1", "default": "CM-PS-014" },
        { "type": "text", "id": "c2", "label": "Col 2", "default": "Oral suspension" },
        { "type": "text", "id": "c3", "label": "Col 3", "default": "SyrSpend SF pH4" },
        { "type": "text", "id": "c4", "label": "Col 4", "default": "0.1 – 50 mg/mL" },
        { "type": "text", "id": "c5", "label": "Col 5", "default": "24 h" },
        { "type": "text", "id": "c6", "label": "Col 6", "default": "Kensington" }
      ]
    },
    {
      "type": "pharmacist",
      "name": "Pharmacist card",
      "settings": [
        { "type": "text", "id": "location", "label": "Location", "default": "Kensington" },
        { "type": "text", "id": "name", "label": "Name", "default": "Priya Raman" },
        { "type": "text", "id": "credential", "label": "Credential", "default": "B.Pharm, MPS — Compounding lead" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "(03) 9376 2140" },
        { "type": "text", "id": "phone_link", "label": "Phone link", "default": "tel:+61393762140" }
      ]
    },
    {
      "type": "pathway",
      "name": "Pathway",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Credentialing" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "AHPRA number, prescriber number and practice address. Verified in two business days." }
      ]
    }
  ],
  "presets": [{ "name": "CanMed — Formulary" }]
}
{% endschema %}
