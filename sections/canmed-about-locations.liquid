<section class="cm-band cm-section" data-cm-about-locations {{ section.shopify_attributes }}>
  <div class="cm-shell">
    <div class="cm-how__head">
      {% if section.settings.eyebrow != blank %}<p class="cm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="cm-display-l">{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>

    <div class="cm-loc-pills" role="radiogroup" aria-label="{{ section.settings.selector_label | default: 'Viewing' | escape }}">
      <p class="cm-mono-caption" style="width:100%; margin-bottom:0.25rem;">{{ section.settings.selector_label | default: 'Viewing' | escape }}</p>
      {% for block in section.blocks %}
        {% if block.type == 'location' %}
          <button
            type="button"
            class="cm-loc-pill{% if forloop.first %} is-active{% endif %}"
            role="radio"
            aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
            data-cm-loc-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.name | escape }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'location' %}
        <div
          class="cm-about-detail"
          data-cm-loc-panel="{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div>
            <h3 class="cm-display-m">{{ block.settings.name | escape }}</h3>
            <address class="cm-mono-data" style="margin-top:1rem; font-style:normal; line-height:1.6; color:rgb(74 63 82 / 0.85);">
              {{ block.settings.address | escape }}<br>
              {{ block.settings.suburb | escape }}
            </address>
            {% if block.settings.phone != blank %}
              <a class="cm-about-phone" href="{{ block.settings.phone_link | default: block.settings.phone }}">{{ block.settings.phone | escape }}</a>
            {% endif %}
            <dl class="cm-about-detail__hours">
              {% if block.settings.hours_1_days != blank %}
                <div><dt>{{ block.settings.hours_1_days | escape }}</dt><dd>{{ block.settings.hours_1_time | escape }}</dd></div>
              {% endif %}
              {% if block.settings.hours_2_days != blank %}
                <div><dt>{{ block.settings.hours_2_days | escape }}</dt><dd>{{ block.settings.hours_2_time | escape }}</dd></div>
              {% endif %}
              {% if block.settings.hours_3_days != blank %}
                <div><dt>{{ block.settings.hours_3_days | escape }}</dt><dd>{{ block.settings.hours_3_time | escape }}</dd></div>
              {% endif %}
            </dl>
            <div style="margin-top:1.5rem;">
              <p class="cm-mono-caption" style="color:var(--cm-muted);">Compounding pharmacist</p>
              <p style="margin:0.5rem 0 0; font-weight:600; color:var(--cm-pine);">{{ block.settings.pharmacist | escape }}</p>
              <p class="cm-mono-data" style="color:var(--cm-muted);">{{ block.settings.credential | escape }}</p>
            </div>
          </div>
          <div
            class="cm-about-detail__map"
            role="img"
            aria-label="Illustrative map panel for the {{ block.settings.name | escape }} dispensary"
          >
            <p class="cm-mono-caption" style="color:rgb(74 63 82 / 0.6);">{{ block.settings.suburb | escape }}</p>
            <p class="cm-mono-data" style="color:rgb(74 63 82 / 0.6);">
              {{ block.settings.map_note | default: 'Parking on site · Tram + rail within 400 m · Step-free entry' | escape }}
            </p>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
<script src="{{ 'canmed-about-locations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "CanMed — About locations",
  "tag": "section",
  "class": "cm-section-about-locations",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Locations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a dispensary." },
    { "type": "text", "id": "selector_label", "label": "Selector label", "default": "Viewing" }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Kensington" },
        { "type": "text", "id": "address", "label": "Address", "default": "412 Macaulay Road" },
        { "type": "text", "id": "suburb", "label": "Suburb", "default": "Kensington VIC 3031" },
        { "type": "text", "id": "phone", "label": "Phone", "default": "(03) 9376 2140" },
        { "type": "text", "id": "phone_link", "label": "Phone link", "default": "tel:+61393762140" },
        { "type": "text", "id": "hours_1_days", "label": "Hours 1 days", "default": "Mon – Fri" },
        { "type": "text", "id": "hours_1_time", "label": "Hours 1 time", "default": "08:30 – 18:00" },
        { "type": "text", "id": "hours_2_days", "label": "Hours 2 days", "default": "Saturday" },
        { "type": "text", "id": "hours_2_time", "label": "Hours 2 time", "default": "09:00 – 13:00" },
        { "type": "text", "id": "hours_3_days", "label": "Hours 3 days", "default": "Sunday" },
        { "type": "text", "id": "hours_3_time", "label": "Hours 3 time", "default": "Closed" },
        { "type": "text", "id": "pharmacist", "label": "Pharmacist", "default": "Priya Raman" },
        { "type": "text", "id": "credential", "label": "Credential", "default": "B.Pharm, MPS — Compounding lead" },
        { "type": "text", "id": "map_note", "label": "Map note", "default": "Parking on site · Tram + rail within 400 m · Step-free entry" }
      ]
    }
  ],
  "presets": [{ "name": "CanMed — About locations" }]
}
{% endschema %}
